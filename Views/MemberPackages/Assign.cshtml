@model GymSaaS.Models.AssignPackageViewModel
@{
    ViewData["Title"] = Model.MemberName;
    ViewData["Subtitle"] = "Assign Package";
}

@section Styles {
    <style>
        .assign-shell {
            max-width: 780px;
        }

        /* Member strip */
        .member-strip {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            box-shadow: var(--sh-sm);
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 20px;
        }

        .ms-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--fire-soft);
            border: 1.5px solid var(--fire-border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-size: 16px;
            font-weight: 800;
            color: var(--fire-text);
            flex-shrink: 0;
        }

        .ms-name {
            font-size: 14px;
            font-weight: 700;
            color: var(--t1);
        }

        .ms-num {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .1em;
            color: var(--t3);
            margin-top: 2px;
        }

        /* Form card */
        .form-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            box-shadow: var(--sh-sm);
            overflow: hidden;
            margin-bottom: 16px;
        }

        .form-section-head {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 22px;
            border-bottom: 1px solid var(--border);
            background: var(--surface-2);
        }

        .form-section-icon {
            width: 30px;
            height: 30px;
            border-radius: var(--r-xs);
            background: var(--fire-soft);
            border: 1px solid var(--fire-border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            color: var(--fire);
            flex-shrink: 0;
        }

        .form-section-title {
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--t1);
        }

        .form-body {
            padding: 22px;
        }

        .form-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        @@media (max-width: 600px) {
            .form-grid-2 {
                grid-template-columns: 1fr;
            }
        }

        .field-hint {
            font-size: 11.5px;
            color: var(--t3);
            margin-top: 5px;
        }

        .field-error {
            font-size: 11.5px;
            color: var(--red);
            margin-top: 5px;
        }

        /* Package selector cards */
        .pkg-selector {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .pkg-option {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border: 1.5px solid var(--border);
            border-radius: var(--r-md);
            cursor: pointer;
            transition: all .15s;
            background: var(--surface);
        }

            .pkg-option:hover {
                border-color: var(--border-strong);
                background: var(--canvas);
            }

            .pkg-option.selected {
                border-color: var(--fire);
                background: var(--fire-soft);
            }

            .pkg-option.is-private {
                background: linear-gradient(90deg, rgba(249,115,22,.05) 0%, #fff 50%);
                border-color: rgba(249,115,22,.4);
            }
            .pkg-option.is-private.selected {
                border-color: #ea580c;
                background: linear-gradient(90deg, rgba(249,115,22,.12) 0%, var(--fire-soft) 100%);
                box-shadow: 0 4px 14px rgba(249,115,22,.18);
            }

            .pkg-option input[type=radio] {
                display: none;
            }

        .pkg-opt-icon {
            width: 34px;
            height: 34px;
            border-radius: var(--r-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

            .pkg-opt-icon.SESSION {
                background: var(--fire-soft);
                color: var(--fire);
                border: 1px solid var(--fire-border);
            }

            .pkg-opt-icon.OPEN_GYM {
                background: var(--blue-bg);
                color: var(--blue);
                border: 1px solid var(--blue-border);
            }

            .pkg-opt-icon.COMBINED {
                background: var(--canvas);
                color: var(--t2);
                border: 1px solid var(--border);
            }

        .pkg-opt-info {
            flex: 1;
            min-width: 0;
        }

        .pkg-opt-name {
            font-size: 13.5px;
            font-weight: 700;
            color: var(--t1);
        }

        .pkg-opt-meta {
            font-size: 11.5px;
            color: var(--t2);
            margin-top: 2px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .pkg-opt-badge {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            font-size: 10px;
            font-weight: 700;
            padding: 1px 7px;
            border-radius: 20px;
            border: 1px solid;
        }

            .pkg-opt-badge.SESSION {
                background: var(--fire-soft);
                color: var(--fire-text);
                border-color: var(--fire-border);
            }

            .pkg-opt-badge.OPEN_GYM {
                background: var(--blue-bg);
                color: var(--blue-text);
                border-color: var(--blue-border);
            }

            .pkg-opt-badge.COMBINED {
                background: var(--canvas);
                color: var(--t2);
                border-color: var(--border);
            }

        .pkg-opt-check {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 2px solid var(--border);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .15s;
        }

        .pkg-option.selected .pkg-opt-check {
            background: var(--fire);
            border-color: var(--fire);
            color: #fff;
            font-size: 10px;
        }

        /* Dynamic date fields */
        .date-section {
            display: none;
        }

            .date-section.show {
                display: block;
            }

        .combined-sep {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 16px 0 12px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--t3);
        }

            .combined-sep::before, .combined-sep::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        /* Branch section */
        #branchSection {
            display: none;
        }

        .home-branch-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--fire-soft);
            border: 1px solid var(--fire-border);
            border-radius: var(--r-sm);
            padding: 7px 12px;
            font-size: 13px;
            font-weight: 700;
            color: var(--fire-text);
            margin-bottom: 14px;
        }

        .branch-section-label {
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--t3);
            margin-bottom: 10px;
            margin-top: 4px;
        }

        .branch-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 8px;
        }

        .branch-check {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border: 1px solid var(--border);
            border-radius: var(--r-sm);
            cursor: pointer;
            transition: all .12s;
            background: var(--surface);
        }

            .branch-check:hover {
                border-color: var(--border-strong);
                background: var(--canvas);
            }

            .branch-check input[type=checkbox] {
                width: 15px;
                height: 15px;
                accent-color: var(--fire);
                cursor: pointer;
                padding: 0;
            }

            .branch-check span {
                font-size: 13px;
                color: var(--t1);
            }

            .branch-check input:checked ~ span {
                color: var(--fire);
                font-weight: 600;
            }

        .form-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding-top: 4px;
        }
    </style>
}

<!-- Back -->
<div style="margin-bottom:20px;">
    <a asp-controller="Members" asp-action="Details" asp-route-id="@Model.MemberId"
       style="display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:500;color:var(--t2);">
        <i class="bi bi-arrow-left" style="font-size:14px;"></i> Back to Profile
    </a>
</div>

<div class="page-header">
    <div>
        <div class="page-title">Assign Package</div>
        <div class="page-sub">Choose a package and set the dates for this member.</div>
    </div>
</div>

<!-- Member strip -->
<div class="member-strip">
    <div class="ms-avatar">
        @string.Concat(Model.MemberName.Split(' ').Take(2).Select(w => w[0].ToString().ToUpper()))
    </div>
    <div>
        <div class="ms-name">@Model.MemberName</div>
        <div class="ms-num">#@Model.MembershipNumber</div>
    </div>
    @if (Model.CurrentPackages.Any())
    {
        <div style="margin-left:auto; display:flex; flex-direction:column; gap:4px; align-items:flex-end;">
            <div style="font-size:10.5px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--t3);">Current Packages</div>
            @foreach (var cp in Model.CurrentPackages.Take(3))
            {
                <div style="font-size:12px; color:var(--t2);">
                    <span style="color:var(--fire);">●</span> @cp.PackageNameSnapshot
                    @if (cp.ValidToDate.HasValue)
                    {
                        <span style="color:var(--t3);">· Exp @cp.ValidToDate.Value.ToString("MMM d")</span>
                    }
                </div>
            }
        </div>
    }
</div>

<form asp-action="Assign" method="post" class="assign-shell" id="assignForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MemberId" />
    <input type="hidden" asp-for="MemberName" />
    <input type="hidden" asp-for="MembershipNumber" />
    <input type="hidden" asp-for="HomeBranchId" />
    <input type="hidden" asp-for="HomeBranchName" />
    <!-- Store member's home branch id and name for display -->
    <input type="hidden" id="homeBranchId" value="@Model.HomeBranchId" />
    <input type="hidden" id="homeBranchName" value="@Model.HomeBranchName" />

    @* Validation summary *@
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div style="background:#fef2f2; border:1px solid #fecaca; border-radius:10px; padding:14px 18px; margin-bottom:16px; display:flex; align-items:flex-start; gap:10px;">
            <i class="bi bi-exclamation-circle" style="color:#dc2626; font-size:16px; flex-shrink:0; margin-top:1px;"></i>
            <div>
                <div style="font-size:13px; font-weight:700; color:#991b1b; margin-bottom:4px;">Please fix the following:</div>
                <ul style="list-style:none; padding:0; margin:0;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors).Where(e => !string.IsNullOrEmpty(e.ErrorMessage)))
                    {
                        <li style="font-size:12.5px; color:#991b1b;">· @error.ErrorMessage</li>
                    }
                </ul>
            </div>
        </div>
    }

    <!-- 1. Select Package -->
    <div class="form-card">
        <div class="form-section-head">
            <div class="form-section-icon"><i class="bi bi-box-seam"></i></div>
            <span class="form-section-title">Select Package</span>
        </div>
        <div class="form-body">
            @if (!Model.AvailablePackages.Any())
            {
                <div style="text-align:center; padding:20px 0; color:var(--t3); font-size:13px;">
                    No active packages in the catalog.
                    <a asp-controller="PackageCatalog" asp-action="Create" style="color:var(--fire);">Create one first.</a>
                </div>
            }
            else
            {
                <div class="pkg-selector">
                    @foreach (var pkg in Model.AvailablePackages)
                    {
                        var meta = pkg.PackageTypeCode switch
                        {
                            "SESSION" => $"{pkg.SessionCount} sessions · {pkg.DurationDays} days validity",
                            "OPEN_GYM" => $"{pkg.DurationDays} days open gym access",
                            "COMBINED" => $"{pkg.SessionCount} sessions ({pkg.DurationDays}d) + gym ({pkg.OpenGymDurationDays}d)",
                            _ => ""
                        };

                        var policyLabel = pkg.BranchAccessPolicy switch
                        {
                            "HOME_ONLY" => "Home branch only",
                            "SELECTED_BRANCHES" => "Home branch + limited other branches",
                            "ALL_BRANCHES" => "All branches",
                            _ => pkg.BranchAccessPolicy
                        };

                        <label class="pkg-option @(pkg.IsPrivateTraining ? "is-private" : "")" onclick="selectPackage(this)"
                               data-type="@pkg.PackageTypeCode"
                               data-policy="@pkg.BranchAccessPolicy"
                               data-private="@(pkg.IsPrivateTraining ? "1" : "0")"
                               data-gym-class-id="@(pkg.GymClassId?.ToString() ?? "")"
                               data-coach-id="@(pkg.CoachId?.ToString() ?? "")"
                               data-sessions="@(pkg.SessionCount?.ToString() ?? "")"
                               data-duration="@(pkg.DurationDays?.ToString() ?? "")"
                               data-gym-duration="@(pkg.OpenGymDurationDays?.ToString() ?? "")"
                               data-invitations="@(pkg.InvitationCount?.ToString() ?? "")"
                               data-inbody="@(pkg.InBodyCount?.ToString() ?? "")"
                               data-pt="@(pkg.PtSessionCount?.ToString() ?? "")"
                               data-freeze="@(pkg.FreezeAllowanceDays?.ToString() ?? "")"
                               data-price="@(pkg.Price?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                               data-min-price="@(pkg.MaxDiscountedPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                            <input type="radio" name="PackageDefinitionId" value="@pkg.PackageDefinitionId" />
                            <div class="pkg-opt-icon @pkg.PackageTypeCode">
                                @if (pkg.IsPrivateTraining)
                                {
                                    <i class="bi bi-person-arms-up"></i>
                                }
                                else if (pkg.PackageTypeCode == "SESSION")
                                {
                                    <i class="bi bi-ticket-perforated"></i>
                                }
                                else if (pkg.PackageTypeCode == "OPEN_GYM")
                                {
                                    <i class="bi bi-door-open"></i>
                                }
                                else
                                {
                                    <i class="bi bi-collection"></i>
                                }
                            </div>
                            <div class="pkg-opt-info">
                                <div style="display:flex; align-items:center; gap:7px; margin-bottom:3px; flex-wrap:wrap;">
                                    <span class="pkg-opt-name">@pkg.PackageName</span>
                                    <span class="pkg-opt-badge @pkg.PackageTypeCode">@pkg.PackageTypeName</span>
                                    @if (pkg.IsPrivateTraining)
                                    {
                                        <span style="font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;background:linear-gradient(135deg,#f97316,#ea580c);color:#fff;padding:3px 9px;border-radius:10px;box-shadow:0 2px 6px rgba(249,115,22,.35);">
                                            <i class="bi bi-person-arms-up"></i> Private Training
                                        </span>
                                    }
                                </div>
                                <div class="pkg-opt-meta">
                                    <span>@meta</span>
                                    <span style="color:var(--t3);">· @policyLabel</span>
                                    @if (pkg.Price.HasValue)
                                    {
                                        <span style="color:var(--fire); font-weight:700;">@pkg.Price.Value.ToString("N0") EGP</span>
                                    }
                                    @if (pkg.MaxDiscountedPrice.HasValue)
                                    {
                                        <span style="color:#6b7280;font-weight:600;">· min @pkg.MaxDiscountedPrice.Value.ToString("N0") after discount</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(pkg.CoachName) || !string.IsNullOrEmpty(pkg.GymClassName))
                                {
                                    <div style="margin-top:4px;display:flex;align-items:center;gap:10px;font-size:11.5px;color:var(--t3);">
                                        @if (!string.IsNullOrEmpty(pkg.GymClassName))
                                        {
                                            <span><i class="bi bi-calendar2-week" style="color:var(--blue,#3b82f6);"></i> @pkg.GymClassName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(pkg.CoachName))
                                        {
                                            <span><i class="bi bi-person-circle" style="color:var(--fire);"></i> Coach @pkg.CoachName</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="pkg-opt-check"><i class="bi bi-check"></i></div>
                        </label>
                    }
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState["PackageDefinitionId"]?.Errors.Count > 0)
                {
                    <div class="field-error" style="display:block; margin-top:10px;">Please select a package.</div>
                }
            }
        </div>
    </div>

    <!-- 2. Branch Selection (shown only for SELECTED_BRANCHES) -->
    <div class="form-card" id="branchSection">
        <div class="form-section-head">
            <div class="form-section-icon"><i class="bi bi-building"></i></div>
            <span class="form-section-title">Allowed Branches</span>
        </div>
        <div class="form-body">
            <!-- Home branch always auto-included -->
            <div class="home-branch-badge">
                <i class="bi bi-house-fill"></i>
                <span id="homeBranchDisplay">@Model.HomeBranchName</span>
                <span style="font-size:10px; font-weight:600; opacity:.7;">(Home — always included)</span>
            </div>

            @{
                var otherBranches = Model.AllBranches.Where(b => b.BranchId != Model.HomeBranchId).ToList();
            }

            @if (otherBranches.Any())
            {
                <div class="branch-section-label">Additional branches this member may also access:</div>
                <div class="branch-grid">
                    @foreach (var b in otherBranches)
                    {
                        <label class="branch-check">
                            <input type="checkbox" name="selectedBranchIds" value="@b.BranchId" />
                            <span>@b.BranchName</span>
                        </label>
                    }
                </div>
            }
            else
            {
                <div style="font-size:13px; color:var(--t3); font-style:italic;">
                    No other branches available to add.
                </div>
            }
        </div>
    </div>

    <!-- 2b. Class link (shown for SESSION / COMBINED) -->
    <div class="form-card" id="classLinkCard" style="display:none;">
        <div class="form-section-head">
            <div class="form-section-icon"><i class="bi bi-calendar2-week"></i></div>
            <span class="form-section-title">Link to Class</span>
        </div>
        <div class="form-body">
            <div class="field" style="max-width:420px;">
                <label class="field-label" asp-for="GymClassId">Specific Class (optional)</label>
                <select asp-for="GymClassId" class="form-select" id="gymClassSelect">
                    <option value="">— Any class —</option>
                    @foreach (var c in Model.AvailableClasses)
                    {
                        <option value="@c.GymClassId" data-coach-id="@(c.CoachId?.ToString() ?? "")">@c.ClassName · @c.TimeDisplay@(string.IsNullOrEmpty(c.CoachName) ? "" : $" · {c.CoachName}")</option>
                    }
                </select>
                <div class="field-hint">
                    If the member can only attend one specific class with this package, pick it here. Otherwise leave blank.
                </div>
            </div>
        </div>
    </div>

    <!-- 2c. Coach assignment (shown only for Private Training packages) -->
    <div class="form-card" id="coachLinkCard" style="display:none; border-color:var(--fire-border); background:linear-gradient(180deg, var(--fire-soft) 0%, var(--surface) 30%);">
        <div class="form-section-head" style="background:var(--fire-soft);">
            <div class="form-section-icon"><i class="bi bi-person-arms-up"></i></div>
            <span class="form-section-title">Assign Personal Trainer <span style="color:var(--fire);">*</span></span>
        </div>
        <div class="form-body">
            <div class="field" style="max-width:480px;">
                <label class="field-label" asp-for="CoachId">Coach</label>
                @if (!Model.AvailableCoaches.Any())
                {
                    <div style="font-size:13px; color:var(--t3); font-style:italic; padding:10px 0;">
                        No active coaches in this branch.
                        <a asp-controller="Coaches" asp-action="Create" style="color:var(--fire);">Add a coach first.</a>
                    </div>
                }
                else
                {
                    <select asp-for="CoachId" class="form-select" id="coachSelect">
                        <option value="">— Select a coach —</option>
                        @foreach (var c in Model.AvailableCoaches)
                        {
                            <option value="@c.CoachId">@c.FullName@(string.IsNullOrEmpty(c.Specialty) ? "" : $" · {c.Specialty}")</option>
                        }
                    </select>
                }
                <div class="field-hint">
                    <i class="bi bi-info-circle"></i> A coach is required for private training packages.
                </div>
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState["CoachId"]?.Errors.Count > 0)
                {
                    <div class="field-error" style="display:block; color:var(--red); margin-top:6px;">@ViewData.ModelState["CoachId"]!.Errors[0].ErrorMessage</div>
                }
            </div>
        </div>
    </div>

    <!-- 3. Dates & Overrides -->
    <div class="form-card">
        <div class="form-section-head">
            <div class="form-section-icon"><i class="bi bi-calendar-range"></i></div>
            <span class="form-section-title">Dates</span>
        </div>
        <div class="form-body">

            <div class="field" style="margin-bottom:16px; max-width:220px;">
                <label class="field-label" asp-for="CustomStartDate">Start Date</label>
                <input asp-for="CustomStartDate" type="date" />
                <div class="field-hint">Defaults to today if not set.</div>
            </div>

            <!-- SESSION date override -->
            <div class="date-section" id="sessionDateSection">
                <div class="field" style="max-width:220px;">
                    <label class="field-label" asp-for="CustomSessionExpiry">Session Expiry Date</label>
                    <input asp-for="CustomSessionExpiry" type="date" />
                    <div class="field-hint">Leave blank to auto-calculate from package duration.</div>
                </div>
            </div>

            <!-- OPEN_GYM date override -->
            <div class="date-section" id="gymDateSection">
                <div class="field" style="max-width:220px;">
                    <label class="field-label" asp-for="CustomOpenGymExpiry">Open Gym Expiry Date</label>
                    <input asp-for="CustomOpenGymExpiry" type="date" />
                    <div class="field-hint">Leave blank to auto-calculate from package duration.</div>
                </div>
            </div>

            <!-- COMBINED date overrides -->
            <div class="date-section" id="combinedDateSection">
                <div class="combined-sep">Sessions Expiry</div>
                <div class="field" style="max-width:220px;">
                    <label class="field-label" asp-for="CustomSessionExpiry">Session Expiry Date</label>
                    <input asp-for="CustomSessionExpiry" type="date" />
                    <div class="field-hint">Leave blank to auto-calculate.</div>
                </div>
                <div class="combined-sep">Open Gym Expiry</div>
                <div class="field" style="max-width:220px;">
                    <label class="field-label" asp-for="CustomOpenGymExpiry">Open Gym Expiry Date</label>
                    <input asp-for="CustomOpenGymExpiry" type="date" />
                    <div class="field-hint">Leave blank to auto-calculate.</div>
                </div>
            </div>

        </div>
    </div>

    <!-- 3b. Pricing / Discount -->
    <div class="form-card" id="pricingCard">
        <div class="form-section-head">
            <div class="form-section-icon"><i class="bi bi-cash-coin"></i></div>
            <span class="form-section-title">Pricing</span>
        </div>
        <div class="form-body">
            <div class="form-grid-2">
                <div class="field" style="max-width:260px;">
                    <label class="field-label" asp-for="FinalPrice">Charged Price (EGP)</label>
                    <input asp-for="FinalPrice" id="finalPriceInput" type="number" step="0.01" min="0"
                           placeholder="Select a package first" />
                    <div class="field-hint" id="priceHint">Pick a package to see the allowed price range.</div>
                    @if (ViewData.ModelState["FinalPrice"]?.Errors.Count > 0)
                    {
                        <div class="field-error" style="display:block;">
                            @ViewData.ModelState["FinalPrice"]!.Errors[0].ErrorMessage
                        </div>
                    }
                </div>
                <div class="field" id="discountSummary" style="display:none;">
                    <label class="field-label">Discount Applied</label>
                    <div id="discountAmount"
                         style="font-weight:800;color:var(--fire);font-size:18px;">—</div>
                    <div class="field-hint" id="discountPct"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Custom Sessions + Carry-over -->
    <div class="form-card" id="sessionOverrideCard" style="display:none;">
        <div class="form-section-head">
            <div class="form-section-icon"><i class="bi bi-ticket-perforated"></i></div>
            <span class="form-section-title">Session Override</span>
        </div>
        <div class="form-body">
            <div class="form-grid-2">
                <div class="field">
                    <label class="field-label" asp-for="CustomSessionCount">Custom Session Count</label>
                    <input asp-for="CustomSessionCount" type="number" min="1" placeholder="Leave blank to use default" />
                    <div class="field-hint">Override the default session count for this assignment only.</div>
                </div>
                <div class="field">
                    <label class="field-label" asp-for="CarryOverSessions">Carry-over Sessions</label>
                    <input asp-for="CarryOverSessions" type="number" min="0" value="0" />
                    <div class="field-hint">Add unused sessions from a previous package.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Perks Override -->
    <div class="form-card" id="perksCard" style="display:none;">
        <div class="form-section-head">
            <div class="form-section-icon"><i class="bi bi-gift"></i></div>
            <span class="form-section-title">Package Perks</span>
        </div>
        <div class="form-body">
            <div style="font-size:12px; color:var(--t3); margin-bottom:14px;">
                Defaults are loaded from the catalog. Override here if needed.
            </div>
            <div class="form-grid-2">
                <div class="field">
                    <label class="field-label"><i class="bi bi-ticket-detailed" style="color:var(--fire);margin-right:4px;"></i> Guest Invitations</label>
                    <input asp-for="CustomInvitationCount" type="number" min="0" id="customInvitations"
                           placeholder="Default from package" />
                </div>
                <div class="field">
                    <label class="field-label"><i class="bi bi-activity" style="color:var(--blue);margin-right:4px;"></i> InBody Scans</label>
                    <input asp-for="CustomInBodyCount" type="number" min="0" id="customInBody"
                           placeholder="Default from package" />
                </div>
                <div class="field">
                    <label class="field-label"><i class="bi bi-person-arms-up" style="color:var(--green);margin-right:4px;"></i> PT Sessions</label>
                    <input asp-for="CustomPtSessionCount" type="number" min="0" id="customPt"
                           placeholder="Default from package" />
                </div>
                <div class="field">
                    <label class="field-label"><i class="bi bi-snow" style="color:var(--blue);margin-right:4px;"></i> Freeze Days</label>
                    <input asp-for="CustomFreezeAllowanceDays" type="number" min="0" id="customFreeze"
                           placeholder="Default from package" />
                </div>
            </div>
            <div id="perksDefaultNote" style="font-size:12px;color:var(--t3);margin-top:10px;display:none;"></div>
        </div>
    </div>

    <!-- 6. Notes -->
    <div class="form-card">
        <div class="form-section-head">
            <div class="form-section-icon"><i class="bi bi-sticky"></i></div>
            <span class="form-section-title">Notes</span>
        </div>
        <div class="form-body">
            <div class="field">
                <label class="field-label" asp-for="Notes">Internal Notes</label>
                <textarea asp-for="Notes" rows="2"
                          placeholder="Optional note about this assignment..."
                          style="resize:vertical;"></textarea>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="form-footer">
        <a asp-controller="Members" asp-action="Details" asp-route-id="@Model.MemberId"
           class="btn btn-ghost"><i class="bi bi-x"></i> Cancel</a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i> Assign Package
        </button>
    </div>

</form>

@section Scripts {
    <script>
        function selectPackage(el) {
            // Visual selection
            document.querySelectorAll('.pkg-option').forEach(o => o.classList.remove('selected'));
            el.classList.add('selected');
            el.querySelector('input[type=radio]').checked = true;

            const type   = el.dataset.type;
            const policy = el.dataset.policy;

            // Show/hide date sections
            document.getElementById('sessionDateSection').classList.toggle('show',  type === 'SESSION');
            document.getElementById('gymDateSection').classList.toggle('show',      type === 'OPEN_GYM');
            document.getElementById('combinedDateSection').classList.toggle('show', type === 'COMBINED');

            // Show session override card for session-based packages
            const showSessions = type === 'SESSION' || type === 'COMBINED';
            document.getElementById('sessionOverrideCard').style.display = showSessions ? 'block' : 'none';

            // Show "Link to Class" picker for class-eligible package types
            const showClassLink = type === 'SESSION' || type === 'COMBINED' || type === 'CLASS';
            document.getElementById('classLinkCard').style.display = showClassLink ? 'block' : 'none';
            if (!showClassLink) {
                const sel = document.querySelector('#classLinkCard select');
                if (sel) sel.value = '';
            }

            // Show coach card ONLY for private training packages
            const isPrivate = el.dataset.private === '1';
            const coachCard = document.getElementById('coachLinkCard');
            const coachSel  = document.getElementById('coachSelect');
            const classSel  = document.getElementById('gymClassSelect');
            const presetClassId = el.dataset.gymClassId || '';
            const presetCoachId = el.dataset.coachId || '';

            if (coachCard) {
                coachCard.style.display = isPrivate ? 'block' : 'none';
                if (coachSel) coachSel.required = isPrivate;
            }

            // Auto-fill the linked CLASS if the package has one
            if (classSel && presetClassId) {
                classSel.value = presetClassId;
            } else if (classSel && !isPrivate) {
                // keep user's manual selection on non-private; don't override
            }

            // Auto-fill the COACH for private packages (from the linked class's coach)
            if (coachSel) {
                if (isPrivate && presetCoachId) {
                    // Only set if the coach exists in the dropdown options
                    const exists = Array.from(coachSel.options).some(o => o.value === presetCoachId);
                    if (exists) coachSel.value = presetCoachId;
                } else if (!isPrivate) {
                    coachSel.value = '';
                }
            }

            // Show branch section ONLY for SELECTED_BRANCHES
            const branchSection = document.getElementById('branchSection');
            if (policy === 'SELECTED_BRANCHES') {
                branchSection.style.display = 'block';
            } else {
                branchSection.style.display = 'none';
                document.querySelectorAll('[name="selectedBranchIds"]').forEach(cb => cb.checked = false);
            }

            // Pricing — sync the FinalPrice input with the package's price + discount floor
            syncPricing(el);

            // Perks card — always show, populate placeholder text with package defaults
            const invitations = el.dataset.invitations;
            const inbody      = el.dataset.inbody;
            const pt          = el.dataset.pt;
            const freeze      = el.dataset.freeze;
            const hasPerks    = invitations || inbody || pt || freeze;

            document.getElementById('perksCard').style.display = hasPerks ? 'block' : 'none';

            if (hasPerks) {
                const setPlaceholder = (id, val) => {
                    const el2 = document.getElementById(id);
                    if (!el2) return;
                    el2.placeholder = val ? `Default: ${val}` : 'Not included';
                    el2.value = '';
                };
                setPlaceholder('customInvitations', invitations);
                setPlaceholder('customInBody',      inbody);
                setPlaceholder('customPt',          pt);
                setPlaceholder('customFreeze',      freeze);

                const parts = [];
                if (invitations) parts.push(`${invitations} invitation${invitations != '1' ? 's' : ''}`);
                if (inbody)      parts.push(`${inbody} InBody`);
                if (pt)          parts.push(`${pt} PT session${pt != '1' ? 's' : ''}`);
                if (freeze)      parts.push(`${freeze}d freeze`);
                const note = document.getElementById('perksDefaultNote');
                note.textContent = parts.length ? `Package includes: ${parts.join(' · ')}` : '';
                note.style.display = parts.length ? 'block' : 'none';
            }
        }

        // ── Pricing sync ──────────────────────────────────────────────────
        // Reads the selected package's price + discount floor from data-attrs,
        // sets the FinalPrice input's min/max, and recomputes the discount summary.
        function syncPricing(el) {
            const priceInput = document.getElementById('finalPriceInput');
            const hint       = document.getElementById('priceHint');
            const summary    = document.getElementById('discountSummary');
            if (!priceInput) return;

            const price    = parseFloat(el.dataset.price)     || null;
            const minPrice = parseFloat(el.dataset.minPrice)  || null;

            if (price == null) {
                priceInput.value = '';
                priceInput.removeAttribute('max');
                priceInput.removeAttribute('min');
                priceInput.placeholder = 'No fixed price — enter amount charged';
                hint.textContent = 'This package has no catalog price; enter the amount the member paid.';
                summary.style.display = 'none';
                return;
            }

            priceInput.max = price.toFixed(2);
            if (minPrice != null) {
                priceInput.min = minPrice.toFixed(2);
                hint.textContent = `Catalog ${price.toLocaleString()} EGP · minimum after discount ${minPrice.toLocaleString()} EGP.`;
            } else {
                priceInput.removeAttribute('min');
                hint.textContent = `Catalog ${price.toLocaleString()} EGP · no discount floor set.`;
            }

            // Default to full catalog price unless the staffer already typed one
            if (!priceInput.value) priceInput.value = price.toFixed(2);
            priceInput.placeholder = price.toLocaleString();
            updateDiscountSummary();
        }

        function updateDiscountSummary() {
            const priceInput = document.getElementById('finalPriceInput');
            const summary    = document.getElementById('discountSummary');
            const amountEl   = document.getElementById('discountAmount');
            const pctEl      = document.getElementById('discountPct');
            if (!priceInput || !summary) return;

            const catalog = parseFloat(priceInput.max);
            const charged = parseFloat(priceInput.value);
            if (!catalog || isNaN(charged)) {
                summary.style.display = 'none';
                return;
            }
            const diff = catalog - charged;
            if (diff <= 0) {
                summary.style.display = 'none';
                return;
            }
            summary.style.display = '';
            amountEl.textContent = `− ${diff.toLocaleString(undefined, {maximumFractionDigits:2})} EGP`;
            pctEl.textContent = `${((diff / catalog) * 100).toFixed(1)}% off catalog price`;
        }

        document.addEventListener('DOMContentLoaded', function () {
            const priceInput = document.getElementById('finalPriceInput');
            if (priceInput) priceInput.addEventListener('input', updateDiscountSummary);
            // If the form was re-rendered after a validation error, re-sync from the
            // currently selected package so min/max are restored.
            const selected = document.querySelector('.pkg-option.selected');
            if (selected) syncPricing(selected);
        });
    </script>
}

@using GymSaaS.Services.Reception

@{
    ViewData["Title"] = "Reception";

    var dashboard = ViewBag.Dashboard as ReceptionDashboardDto;
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    var branches = ViewBag.Branches as List<BranchOptionDto> ?? new();
    var selectedBranchId = ViewBag.SelectedBranchId as Guid?;
}

<style>
    .reception-page {
        width: 100%;
        max-width: 1180px;
        padding: 26px 28px;
    }

    .reception-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

    .reception-title {
        font-size: 24px;
        font-weight: 800;
        margin: 0;
        letter-spacing: .3px;
        color: #111827;
    }

    .reception-subtitle {
        margin: 4px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .reception-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 18px;
    }

    .reception-card {
        background: #fff;
        border: 1px solid rgba(15,23,42,0.06);
        border-radius: 18px;
        box-shadow: 0 1px 2px rgba(15,23,42,0.04), 0 6px 18px rgba(15,23,42,0.05);
        position: relative;
        transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
    }

        .reception-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.9), transparent);
            border-radius: 18px 18px 0 0;
            pointer-events: none;
        }

        .reception-card:hover {
            box-shadow: 0 4px 8px rgba(15,23,42,0.05), 0 14px 32px rgba(15,23,42,0.08);
            border-color: rgba(15,23,42,0.10);
        }

    /* Stat cards inside reception-grid lift a bit on hover */
    .reception-grid .reception-card {
        transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
    }

    .reception-grid .reception-card:hover {
        transform: translateY(-2px);
    }

    .reception-card-body {
        padding: 22px;
    }

    .stat-label {
        color: #6b7280;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 6px;
        letter-spacing: -0.01em;
        line-height: 1;
    }

    .stat-note {
        color: #9ca3af;
        font-size: 12.5px;
    }

    .main-area {
        display: grid;
        grid-template-columns: minmax(0, 760px) minmax(280px, 1fr);
        gap: 18px;
    }

    .section-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 17px;
        font-weight: 800;
        margin-bottom: 18px;
        color: #111827;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .form-label-clean {
        display: block;
        font-size: 11px;
        color: #6b7280;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .scan-row {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .scan-input {
        flex: 1;
        min-height: 48px;
        border-radius: 12px;
        border: 1.5px solid rgba(251, 106, 22, 0.45);
        padding: 0 16px;
        outline: none;
        font-size: 14px;
        background: #fff;
        box-shadow: 0 1px 2px rgba(15,23,42,0.04);
        transition: all 0.18s ease;
    }

        .scan-input:hover {
            border-color: rgba(251, 106, 22, 0.65);
        }

        .scan-input:focus {
            border-color: #fb6a16;
            box-shadow: 0 0 0 4px rgba(251, 106, 22, .14), 0 2px 6px rgba(251, 106, 22, .08);
        }

    .orange-btn {
        min-height: 48px;
        border: none;
        border-radius: 12px;
        padding: 0 22px;
        background: linear-gradient(135deg, #ff5b14, #ea4f0f);
        color: #fff;
        font-weight: 800;
        cursor: pointer;
        letter-spacing: 0.02em;
        box-shadow: 0 1px 2px rgba(255,91,20,0.30), 0 4px 12px rgba(255,91,20,0.22), inset 0 1px 0 rgba(255,255,255,0.18);
        transition: all 0.18s ease;
    }

        .orange-btn:hover:not(:disabled) {
            box-shadow: 0 4px 10px rgba(255,91,20,0.32), 0 8px 20px rgba(255,91,20,0.24), inset 0 1px 0 rgba(255,255,255,0.18);
            transform: translateY(-1px);
        }

        .orange-btn:active:not(:disabled) {
            transform: translateY(0) scale(0.98);
        }

        .orange-btn:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .schedule-empty {
        padding: 34px 20px;
        text-align: center;
        color: #6b7280;
    }

    .schedule-empty-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        background: #fff4ed;
        color: #ff5b14;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
        font-size: 24px;
    }

    .branch-select {
        min-height: 40px;
        min-width: 220px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        padding: 0 12px;
        background: #fff;
    }

    .custom-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, .45);
        z-index: 9998;
    }

        .custom-modal-overlay.is-open {
            display: block;
        }

    .custom-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: min(520px, calc(100% - 32px));
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .28);
        overflow: hidden;
    }

        .custom-modal.is-open {
            display: block;
        }

    .custom-modal-header {
        padding: 22px 24px 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .custom-modal-title {
        font-size: 20px;
        font-weight: 800;
        margin: 0;
    }

    .modal-close-btn {
        border: none;
        background: #f3f4f6;
        border-radius: 10px;
        width: 34px;
        height: 34px;
        cursor: pointer;
    }

    .custom-modal-body {
        padding: 18px 24px 24px;
    }

    .member-card {
        display: flex;
        gap: 14px;
        align-items: center;
        margin-bottom: 18px;
    }

    .member-photo {
        width: 74px;
        height: 74px;
        object-fit: cover;
        border-radius: 50%;
        border: 1px solid #e5e7eb;
        background: #f9fafb;
    }

    .member-name {
        font-size: 18px;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .member-badge {
        display: inline-block;
        background: #fff4ed;
        color: #ff5b14;
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 800;
    }

    .alert-clean {
        border-radius: 16px;
        padding: 14px 16px;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .alert-success-clean {
        background: #ecfdf3;
        color: #027a48;
    }

    .alert-warning-clean {
        background: #fffaeb;
        color: #b54708;
    }

    .alert-danger-clean {
        background: #fef3f2;
        color: #b42318;
    }

    .package-buttons {
        display: grid;
        gap: 10px;
        margin-top: 12px;
    }

    .package-btn {
        border: 1px solid #ff5b14;
        background: #fff;
        color: #ff5b14;
        border-radius: 14px;
        padding: 12px 14px;
        text-align: left;
        font-weight: 800;
        cursor: pointer;
    }

        .package-btn:hover {
            background: #fff4ed;
        }

    .d-none {
        display: none !important;
    }

    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: .5; transform: scale(1.3); }
    }

    @@keyframes scan-success-pop {
        0%   { transform: scale(.6); opacity: 0; }
        60%  { transform: scale(1.15); opacity: 1; }
        100% { transform: scale(1); opacity: 1; }
    }

    @@keyframes scan-success-ring {
        0%   { box-shadow: 0 0 0 0 rgba(34,197,94,.55); }
        100% { box-shadow: 0 0 0 28px rgba(34,197,94,0); }
    }

    .scan-success-anim .member-photo {
        animation: scan-success-pop .55s ease-out, scan-success-ring 1.1s ease-out;
        border: 3px solid #22c55e;
    }

    .sessions-left-alert {
        background: linear-gradient(135deg, #fff8f3 0%, #ffe9d6 100%);
        border: 1.5px solid #ff5b14;
        border-radius: 16px;
        padding: 14px 16px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
        animation: scan-success-pop .5s ease-out;
    }

    .sessions-left-alert .big-num {
        font-size: 30px;
        font-weight: 900;
        color: #ff5b14;
        line-height: 1;
        min-width: 42px;
        text-align: center;
    }

    .sessions-left-alert .label {
        font-weight: 800;
        color: #111827;
        font-size: 14px;
    }

    .sessions-left-alert .sub {
        font-size: 12px;
        color: #6b7280;
        margin-top: 2px;
    }

    @@media (max-width: 1200px) {
        .reception-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .main-area {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {
        .reception-page {
            padding: 18px;
        }

        .reception-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 14px;
        }

        .reception-grid {
            grid-template-columns: 1fr;
        }

        .scan-row {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

<div class="reception-page">

    <div class="reception-header">
        <div>
            <h1 class="reception-title">Reception</h1>
            <p class="reception-subtitle">Scan members, check branch access, and manage live attendance.</p>
        </div>

        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end;">
            <a asp-action="DropIn" asp-route-branchId="@selectedBranchId" class="orange-btn"
               style="min-height:40px;padding:0 16px;text-decoration:none;display:inline-flex;align-items:center;gap:7px;">
                <i class="bi bi-person-plus-fill"></i> Paid Drop-In
            </a>
            @if (isAdmin)
            {
                <a asp-action="DropInSettings" class="btn btn-secondary" title="Drop-in prices">
                    <i class="bi bi-gear"></i>
                </a>
            }
            @if (isAdmin && branches.Count > 0)
            {
                <select id="branchSelector" class="branch-select">
                    @foreach (var b in branches)
                    {
                        if (b.BranchId == selectedBranchId)
                        {
                            <option value="@b.BranchId" selected>@b.BranchName</option>
                        }
                        else
                        {
                            <option value="@b.BranchId">@b.BranchName</option>
                        }
                    }
                </select>
            }
        </div>
    </div>

    @Html.AntiForgeryToken()

    @if (dashboard != null)
    {
        <div class="reception-grid">
            <div class="reception-card">
                <div class="reception-card-body" style="display:flex;align-items:center;gap:16px;">
                    @{
                        int capPct      = dashboard.MaxCapacity > 0 ? dashboard.CapacityPercent : 0;
                        int radius      = 28;
                        double circ     = 2 * Math.PI * radius;
                        double dashVal  = dashboard.MaxCapacity > 0 ? circ * capPct / 100.0 : 0;
                        string ringColor = capPct >= 90 ? "#dc2626"
                                         : capPct >= 70 ? "#f59e0b"
                                         : "#16a34a";
                    }
                    <svg id="capacityRing" width="72" height="72" viewBox="0 0 72 72" style="flex-shrink:0;">
                        <circle cx="36" cy="36" r="@radius" fill="none" stroke="#f3f4f6" stroke-width="7"/>
                        <circle id="capacityArc" cx="36" cy="36" r="@radius" fill="none"
                                stroke="@ringColor" stroke-width="7"
                                stroke-linecap="round"
                                stroke-dasharray="@dashVal.ToString("F1") @circ.ToString("F1")"
                                stroke-dashoffset="@(circ / 4.0).ToString("F1")"
                                transform="rotate(-90 36 36)"
                                style="transition:stroke-dasharray 0.5s ease;" />
                        <text x="36" y="40" text-anchor="middle"
                              font-size="13" font-weight="800" fill="#111827">
                            @(dashboard.MaxCapacity > 0 ? $"{capPct}%" : "—")
                        </text>
                    </svg>
                    <div>
                        <div class="stat-label">Gym Capacity</div>
                        @if (dashboard.MaxCapacity > 0)
                        {
                            <div id="capCount" class="stat-value" style="font-size:22px;">@dashboard.CurrentlyPresentCount<span style="font-size:14px;font-weight:500;color:#9ca3af;"> / @dashboard.MaxCapacity</span></div>
                            <div class="stat-note" id="capNote">@capPct% full</div>
                        }
                        else
                        {
                            <div id="capCount" class="stat-value" style="font-size:22px;">@dashboard.CurrentlyPresentCount</div>
                            <div class="stat-note" id="capNote">No capacity limit</div>
                        }
                    </div>
                </div>
            </div>

            <div class="reception-card">
                <div class="reception-card-body">
                    <div class="stat-label">Currently Inside</div>
                    <div class="stat-value" id="statCurrently">@dashboard.CurrentlyPresentCount</div>
                    <div class="stat-note">Auto-exit after @(ViewBag.PresenceWindowMinutes ?? 120) min</div>
                </div>
            </div>

            <div class="reception-card">
                <div class="reception-card-body">
                    <div class="stat-label">Today's Entries</div>
                    <div class="stat-value" id="statToday">@dashboard.TodayEntryCount</div>
                    <div class="stat-note">Total check-ins since midnight</div>
                </div>
            </div>

            <div class="reception-card">
                <div class="reception-card-body">
                    <div class="stat-label">Classes Today</div>
                    <div class="stat-value">@dashboard.TodayClassesCount</div>
                    <div class="stat-note">
                        @{
                            var liveCount = dashboard.TodayClasses.Count(c => c.IsLive);
                        }
                        @if (liveCount > 0)
                        {
                            <span style="color:#16a34a;font-weight:700;">@liveCount live now</span>
                        }
                        else if (dashboard.TodayClassesCount == 0)
                        {
                            <span>No classes scheduled</span>
                        }
                        else
                        {
                            <span>scheduled today</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="main-area">
            <div>
                <div class="reception-card" style="margin-bottom:18px;">
                    <div class="reception-card-body">
                        <div class="section-title">Member Check-In</div>

                        <label class="form-label-clean">Membership Number or Phone</label>

                        <div class="scan-row">
                            <input type="text"
                                   id="membershipNumberInput"
                                   class="scan-input"
                                   placeholder="Enter membership number or phone..."
                                   autocomplete="off"
                                   autofocus />

                            <button type="button" id="btnScan" class="orange-btn">
                                Check In
                            </button>
                        </div>

                        <div id="scanSpinner" class="d-none" style="margin-top:12px;color:#ff5b14;font-weight:700;">
                            Processing...
                        </div>
                    </div>
                </div>

                <div class="reception-card">
                    <!-- Schedule header -->
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 22px 0;">
                        <div class="section-title" style="margin-bottom:0;">Today's Schedule</div>
                        @if (dashboard.TodayClasses.Any(c => c.IsLive))
                        {
                            <span style="display:inline-flex;align-items:center;gap:6px;background:#dcfce7;color:#16a34a;font-size:11.5px;font-weight:800;padding:4px 12px;border-radius:999px;">
                                <span style="width:7px;height:7px;border-radius:50%;background:#16a34a;display:inline-block;animation:pulse-dot 1.4s ease-in-out infinite;"></span>
                                LIVE NOW
                            </span>
                        }
                    </div>

                    @if (!dashboard.TodayClasses.Any())
                    {
                        <div class="reception-card-body">
                            <div class="schedule-empty">
                                <div class="schedule-empty-icon">📅</div>
                                <div style="font-weight:700;margin-bottom:4px;">No classes today</div>
                                <div style="font-size:13px;">Check the <a href="/Classes/Schedule" style="color:#ff5b14;">weekly schedule</a>.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Timeline -->
                        <div style="padding:18px 22px 22px;display:flex;flex-direction:column;gap:0;">
                            @{ int schedIdx = 0; }
                            @foreach (var cls in dashboard.TodayClasses)
                            {
                                bool isFirst = schedIdx == 0;
                                bool isLast  = schedIdx == dashboard.TodayClasses.Count - 1;
                                schedIdx++;

                                string dotColor  = cls.IsLive ? "#ff5b14" : cls.IsUpcoming ? "#3b82f6" : "#d1d5db";
                                string dotBg     = cls.IsLive ? "#fff4ed" : cls.IsUpcoming ? "#eff6ff" : "#f9fafb";
                                string cardBg    = cls.IsLive ? "#fff8f5" : cls.IsUpcoming ? "#fff" : "#fafafa";
                                string cardBorderColor = cls.IsLive ? "#ff5b14" : cls.IsUpcoming ? "#bfdbfe" : "#e5e7eb";
                                string nameColor = cls.IsDone ? "#9ca3af" : "#111827";
                                string timeColor = cls.IsLive ? "#ff5b14" : cls.IsUpcoming ? "#3b82f6" : "#9ca3af";

                                <div style="display:flex;gap:14px;position:relative;">
                                    <!-- Timeline spine -->
                                    <div style="display:flex;flex-direction:column;align-items:center;flex-shrink:0;width:28px;">
                                        <div style="width:12px;height:12px;border-radius:50%;background:@dotBg;border:2px solid @dotColor;flex-shrink:0;margin-top:14px;
                                                    @(cls.IsLive ? "box-shadow:0 0 0 3px rgba(255,91,20,.15);" : "")">
                                        </div>
                                        @if (!isLast)
                                        {
                                            <div style="width:2px;flex:1;background:@(cls.IsLive ? "#fdba74" : "#e5e7eb");min-height:14px;margin-top:4px;"></div>
                                        }
                                    </div>

                                    <!-- Class card -->
                                    <div style="flex:1;margin-bottom:@(isLast ? "0" : "10px");">
                                        <div style="border:1px solid @cardBorderColor;border-radius:16px;background:@cardBg;overflow:hidden;
                                                    @(cls.IsLive ? "box-shadow:0 2px 12px rgba(255,91,20,.10);" : "")">

                                            <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;">
                                                <!-- Photo / icon -->
                                                @if (!string.IsNullOrEmpty(cls.PhotoUrl))
                                                {
                                                    <img src="@cls.PhotoUrl" alt="@cls.ClassName"
                                                         style="width:42px;height:42px;object-fit:cover;border-radius:10px;flex-shrink:0;@(cls.IsDone ? "filter:grayscale(60%);" : "")" />
                                                }
                                                else
                                                {
                                                    <div style="width:42px;height:42px;border-radius:10px;background:@dotBg;border:1px solid @cardBorderColor;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:19px;">
                                                        🏋️
                                                    </div>
                                                }

                                                <!-- Info -->
                                                <div style="flex:1;min-width:0;">
                                                    <div style="font-weight:800;font-size:13.5px;color:@nameColor;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                                        @cls.ClassName
                                                    </div>
                                                    <div style="font-size:11.5px;color:@timeColor;font-weight:600;margin-top:2px;">
                                                        @cls.TimeDisplay
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(cls.CoachName) || cls.Capacity.HasValue)
                                                    {
                                                        <div style="font-size:11px;color:#9ca3af;margin-top:2px;">
                                                            @if (!string.IsNullOrEmpty(cls.CoachName)) { <span>@cls.CoachName</span> }
                                                            @if (!string.IsNullOrEmpty(cls.CoachName) && cls.Capacity.HasValue) { <span> · </span> }
                                                            @if (cls.Capacity.HasValue) { <span>max @cls.Capacity</span> }
                                                        </div>
                                                    }
                                                </div>

                                                <!-- Status badge -->
                                                @if (cls.IsLive)
                                                {
                                                    <span style="flex-shrink:0;display:inline-flex;align-items:center;gap:5px;background:#fff4ed;color:#ff5b14;font-size:11px;font-weight:800;padding:4px 10px;border-radius:999px;border:1px solid #fed7aa;">
                                                        <span style="width:6px;height:6px;border-radius:50%;background:#ff5b14;display:inline-block;animation:pulse-dot 1.4s ease-in-out infinite;"></span>
                                                        LIVE
                                                    </span>
                                                }
                                                else if (cls.IsUpcoming)
                                                {
                                                    <span style="flex-shrink:0;background:#eff6ff;color:#3b82f6;font-size:11px;font-weight:800;padding:4px 10px;border-radius:999px;border:1px solid #bfdbfe;">NEXT</span>
                                                }
                                                else
                                                {
                                                    <span style="flex-shrink:0;background:#f3f4f6;color:#d1d5db;font-size:11px;font-weight:700;padding:4px 10px;border-radius:999px;">DONE</span>
                                                }
                                            </div>

                                            @* Progress bar for live classes *@
                                            @if (cls.IsLive)
                                            {
                                                <div style="height:3px;background:#fee2d0;">
                                                    <div id="liveBar_@schedIdx" style="height:100%;background:#ff5b14;border-radius:0 2px 2px 0;width:0%;transition:width .5s;"></div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:18px;">
                <div class="reception-card">
                    <div class="reception-card-body">
                        <div class="section-title">Reception Notes</div>
                        <div class="stat-note" style="line-height:1.8;">
                            Search by membership number, QR, or NFC card value.
                            If the member has multiple active packages, the system will ask which package should be used.
                        </div>
                    </div>
                </div>

                <!-- Invitation Widget -->
                <div class="reception-card" id="invWidgetCard">
                    <div class="reception-card-body">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                            <div class="section-title" style="margin-bottom:0;">Record Invitation</div>
                            <a href="/Invitations/Index" style="font-size:11.5px;color:#ff5b14;font-weight:700;">View Log →</a>
                        </div>

                        <!-- Step 1: find the member -->
                        <div id="invStep1">
                            <label class="form-label-clean">Member (by # or phone)</label>
                            <div style="display:flex;gap:8px;">
                                <input type="text" id="invMemberSearch" class="scan-input" style="min-height:40px;font-size:13px;"
                                       placeholder="Membership # or phone..." autocomplete="off" />
                                <button type="button" id="invSearchBtn" class="orange-btn" style="min-height:40px;padding:0 14px;font-size:12px;">
                                    Find
                                </button>
                            </div>
                            <div id="invMemberResult" style="margin-top:10px;font-size:12.5px;"></div>
                        </div>

                        <!-- Step 2: enter guest details (hidden until member found with slots) -->
                        <div id="invStep2" style="display:none;margin-top:14px;border-top:1px solid #e5e7eb;padding-top:14px;">
                            <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
                                <img id="invMemberPhoto" src="/images/avatar-placeholder.png"
                                     style="width:38px;height:38px;border-radius:50%;object-fit:cover;border:1px solid #e5e7eb;" />
                                <div>
                                    <div id="invMemberName" style="font-weight:800;font-size:13px;color:#111827;"></div>
                                    <div id="invMemberSlots" style="font-size:11px;color:#ff5b14;font-weight:700;"></div>
                                </div>
                            </div>

                            <div style="margin-bottom:10px;">
                                <label class="form-label-clean">Guest Name</label>
                                <input type="text" id="invGuestNameR" class="scan-input" style="min-height:38px;font-size:13px;" placeholder="Full name" />
                            </div>

                            <div style="margin-bottom:12px;">
                                <label class="form-label-clean">Guest Phone</label>
                                <input type="text" id="invGuestPhoneR" class="scan-input" style="min-height:38px;font-size:13px;" placeholder="+20 1xx xxxxxxx" />
                            </div>

                            <div id="invFeedback" style="font-size:12px;margin-bottom:10px;"></div>

                            <div style="display:flex;gap:8px;">
                                <button type="button" id="invSubmitBtn" class="orange-btn" style="flex:1;min-height:38px;font-size:13px;">
                                    <i class="bi bi-ticket-detailed"></i> Record
                                </button>
                                <button type="button" id="invResetBtn" class="orange-btn" style="min-height:38px;padding:0 12px;background:#f3f4f6;color:#6b7280;font-size:12px;">
                                    ✕
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="reception-card">
            <div class="reception-card-body">
                No branch selected or branch not found.
            </div>
        </div>
    }
</div>

<div id="customModalOverlay" class="custom-modal-overlay"></div>

<div id="memberModal" class="custom-modal">
    <div id="modalError" class="d-none">
        <div class="custom-modal-body" style="text-align:center;padding-top:38px;">
            <div class="alert-clean alert-danger-clean">
                <strong id="modalErrorTitle">Entry Denied</strong>
                <div id="modalErrorMessage" style="margin-top:6px;"></div>
            </div>

            <button type="button" class="orange-btn" data-close-modal>Close</button>
        </div>
    </div>

    <div id="modalSuccess">
        <div class="custom-modal-header">
            <h5 class="custom-modal-title">Member Check-In</h5>
            <button type="button" class="modal-close-btn" data-close-modal>×</button>
        </div>

        <div class="custom-modal-body">
            <div class="member-card">
                <img id="memberPhoto"
                     src="/images/avatar-placeholder.png"
                     class="member-photo"
                     alt="Member Photo" />

                <div style="flex:1;min-width:0;">
                    <div class="member-name" id="memberName">—</div>
                    <span class="member-badge" id="membershipBadge">—</span>
                    <div id="memberPhone" class="d-none" style="margin-top:6px;font-size:12.5px;color:#6b7280;">
                        <i class="bi bi-telephone" style="font-size:11px;margin-right:3px;"></i>
                        <span id="memberPhoneVal"></span>
                    </div>
                </div>
            </div>

            <div id="memberPackageInfo" class="d-none"
                 style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:12px;padding:10px 14px;margin-bottom:12px;font-size:13px;display:flex;align-items:center;gap:8px;">
                <i class="bi bi-ticket-perforated" style="color:#ff5b14;font-size:15px;flex-shrink:0;"></i>
                <div>
                    <span id="memberPackageName" style="font-weight:700;color:#111827;"></span>
                    <span id="memberPackageExpiry" style="color:#9ca3af;font-size:11.5px;margin-left:6px;"></span>
                </div>
            </div>

            <div id="sessionsLeftAlert" class="sessions-left-alert d-none">
                <div class="big-num" id="sessionsLeftNum">—</div>
                <div style="flex:1;min-width:0;">
                    <div class="label" id="sessionsLeftLabel">sessions remaining</div>
                    <div class="sub" id="sessionsLeftPkgName"></div>
                </div>
            </div>

            <!-- PT session perk — shown when member has PT sessions remaining -->
            <div id="ptPerkPanel" class="d-none"
                 style="background:#f5f3ff;border:1.5px solid #8b5cf6;border-radius:14px;padding:12px 14px;margin-bottom:12px;">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                    <i class="bi bi-person-arms-up" style="color:#7c3aed;font-size:18px;"></i>
                    <div style="flex:1;">
                        <div style="font-weight:800;color:#111827;font-size:13.5px;">Personal Training</div>
                        <div style="font-size:11.5px;color:#6b7280;">
                            <span id="ptRemainingNum" style="font-weight:800;color:#7c3aed;">0</span> sessions left
                        </div>
                    </div>
                </div>
                <select id="ptPackageSelect" class="scan-input"
                        style="width:100%;min-height:38px;font-size:13px;margin-bottom:8px;"></select>
                <div style="display:flex;gap:8px;align-items:center;">
                    <select id="ptCoachSelect" class="scan-input"
                            style="flex:1;min-height:38px;font-size:13px;"></select>
                    <button type="button" id="btnRecordPt" class="orange-btn"
                            style="min-height:38px;padding:0 14px;font-size:12.5px;background:#7c3aed;white-space:nowrap;">
                        <i class="bi bi-check2"></i> Record PT
                    </button>
                </div>
                <div id="ptFeedback" style="margin-top:7px;font-size:12px;"></div>
            </div>

            <!-- InBody perk — shown when member has InBody scans remaining -->
            <div id="inBodyPerkPanel" class="d-none"
                 style="background:#ecfeff;border:1.5px solid #06b6d4;border-radius:14px;padding:12px 14px;margin-bottom:12px;display:flex;align-items:center;gap:10px;">
                <i class="bi bi-clipboard2-pulse" style="color:#0891b2;font-size:18px;"></i>
                <div style="flex:1;">
                    <div style="font-weight:800;color:#111827;font-size:13.5px;">InBody Scan</div>
                    <div style="font-size:11.5px;color:#6b7280;">
                        <span id="inBodyRemainingNum" style="font-weight:800;color:#0891b2;">0</span> scans left
                    </div>
                </div>
                <button type="button" id="btnRecordInBody" class="orange-btn"
                        style="min-height:38px;padding:0 14px;font-size:12.5px;background:#0891b2;white-space:nowrap;">
                    <i class="bi bi-check2"></i> Record InBody
                </button>
            </div>

            <div id="classInfo" class="d-none"
                 style="background:#fff8f3;border:1px solid #fed7aa;border-radius:12px;padding:10px 14px;margin-bottom:12px;font-size:13px;display:flex;align-items:center;gap:10px;">
                <i class="bi bi-calendar2-event" style="color:#ff5b14;font-size:16px;flex-shrink:0;"></i>
                <div style="flex:1;min-width:0;">
                    <div style="font-weight:800;color:#111827;" id="classInfoName">—</div>
                    <div style="font-size:11.5px;color:#6b7280;margin-top:2px;">
                        <span id="classInfoTime"></span>
                        <span id="classInfoCoach"></span>
                    </div>
                </div>
                <div id="classCapacityBadge"
                     style="background:#fff;border:1px solid #e5e7eb;border-radius:999px;padding:3px 10px;font-size:11px;font-weight:800;color:#374151;flex-shrink:0;">
                    —
                </div>
            </div>

            <div id="classFullAlert" class="alert-clean alert-danger-clean d-none">
                <strong>Class is full.</strong>
                <div style="margin-top:4px;font-size:12.5px;">
                    Override and let the member in anyway?
                </div>
                <div style="margin-top:10px;display:flex;gap:8px;">
                    <button type="button" id="btnOverrideClassFull" class="orange-btn"
                            style="min-height:36px;padding:0 14px;font-size:12.5px;">
                        Allow Entry
                    </button>
                    <button type="button" class="orange-btn" data-close-modal
                            style="min-height:36px;padding:0 14px;font-size:12.5px;background:#f3f4f6;color:#374151;">
                        Cancel
                    </button>
                </div>
            </div>

            <div id="alreadyInsideAlert" class="alert-clean alert-warning-clean d-none">
                This member is already inside the gym.
            </div>

            <div id="autoCheckinAlert" class="alert-clean alert-success-clean d-none">
                Checked in successfully via <strong id="autoPackageName"></strong>.
            </div>

            <div id="conflictSection" class="d-none">
                <div class="stat-note" id="conflictNote">
                    This member has multiple active packages. Please select how to check them in:
                </div>

                <div id="packageButtons" class="package-buttons"></div>

                <!-- Class picker shown when checking in on a session package -->
                <div id="classPickerSection" class="d-none" style="margin-top:14px;">
                    <div class="stat-note" id="classPickerNote">Which class is the member attending?</div>
                    <select id="classPickerSelect"
                            style="margin-top:8px;width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;background:#fff;"></select>
                    <div id="classPickerFullWarn" class="d-none" style="margin-top:8px;">
                        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:12.5px;color:#b42318;">
                            <input type="checkbox" id="classPickerOverride" style="width:15px;height:15px;" />
                            This class is full — allow entry anyway (override capacity).
                        </label>
                    </div>
                    <div style="margin-top:12px;display:flex;gap:8px;">
                        <button type="button" id="btnConfirmClass" class="orange-btn"
                                style="min-height:38px;padding:0 16px;font-size:13px;">
                            Confirm Check-In
                        </button>
                        <button type="button" id="btnCancelClass"
                                style="min-height:38px;padding:0 14px;font-size:13px;background:#f3f4f6;border:1px solid #d1d5db;border-radius:8px;cursor:pointer;">
                            Back
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const branchId = '@(selectedBranchId?.ToString() ?? "")';
            const antiforgery = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

            const branchSelector = document.getElementById('branchSelector');
            const btnScan = document.getElementById('btnScan');
            const input = document.getElementById('membershipNumberInput');
            const spinner = document.getElementById('scanSpinner');

            const overlay = document.getElementById('customModalOverlay');
            const modal = document.getElementById('memberModal');

            const modalError = document.getElementById('modalError');
            const modalSuccess = document.getElementById('modalSuccess');
            const alreadyAlert = document.getElementById('alreadyInsideAlert');
            const autoAlert = document.getElementById('autoCheckinAlert');
            const conflictSection = document.getElementById('conflictSection');
            const packageButtons = document.getElementById('packageButtons');

            if (branchSelector) {
                branchSelector.addEventListener('change', function () {
                    window.location.href = '/Reception/Index?branchId=' + branchSelector.value;
                });
            }

            if (btnScan && input) {
                btnScan.addEventListener('click', doScan);

                input.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        doScan();
                    }
                });
            }

            document.querySelectorAll('[data-close-modal]').forEach(function (btn) {
                btn.addEventListener('click', closeModal);
            });

            overlay.addEventListener('click', closeModal);

            async function doScan() {
                const membershipNumber = input.value.trim();

                // Empty input — silently refocus rather than popping a scary modal.
                // This avoids the "Missing Membership Number" pop-up after a
                // successful check-in when a stray Enter / double-click fires.
                if (!membershipNumber) {
                    input.focus();
                    return;
                }

                // Modal is already open — ignore (prevents double-trigger from
                // a stray Enter while the success popup is still showing).
                if (modal.classList.contains('is-open')) {
                    return;
                }

                if (!branchId) {
                    showModalError('No Branch Selected', 'Please select a branch first.');
                    return;
                }

                setLoading(true);

                try {
                    const res = await fetch('/Reception/Scan', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiforgery
                        },
                        body: JSON.stringify({
                            membershipNumber: membershipNumber,
                            branchId: branchId
                        })
                    });

                    const data = await res.json();
                    input.value = '';
                    showModal(data);
                }
                catch {
                    showModalError('Network Error', 'Could not reach server. Please try again.');
                }
                finally {
                    setLoading(false);
                }
            }

            function showModal(data) {
                resetModal();

                if (!data.success) {
                    showModalError(getErrorTitle(data.errorCode), data.errorMessage);
                    return;
                }

                document.getElementById('memberName').textContent = data.memberName ?? '—';
                document.getElementById('membershipBadge').textContent = data.membershipNumber ?? '—';

                const photo = document.getElementById('memberPhoto');
                photo.src = data.photoUrl ? data.photoUrl : '/images/avatar-placeholder.png';

                // Phone
                if (data.phoneNumber) {
                    document.getElementById('memberPhoneVal').textContent = data.phoneNumber;
                    document.getElementById('memberPhone').classList.remove('d-none');
                }

                // Package info
                if (data.activePackageName) {
                    document.getElementById('memberPackageName').textContent = data.activePackageName;
                    const expEl = document.getElementById('memberPackageExpiry');
                    expEl.textContent = data.activePackageExpiry ? ('Exp ' + data.activePackageExpiry) : '';
                    document.getElementById('memberPackageInfo').classList.remove('d-none');
                }

                // Class info (for CLASS package check-ins)
                if (data.targetClassName) {
                    document.getElementById('classInfoName').textContent = data.targetClassName;
                    document.getElementById('classInfoTime').textContent = data.targetClassTime ?? '';
                    document.getElementById('classInfoCoach').textContent =
                        data.targetCoachName ? (' · ' + data.targetCoachName) : '';

                    const capBadge = document.getElementById('classCapacityBadge');
                    if (data.targetClassCapacity != null) {
                        capBadge.textContent = (data.targetClassAttendees ?? 0) + ' / ' + data.targetClassCapacity;
                        if (data.classIsFull) {
                            capBadge.style.background    = '#fef2f2';
                            capBadge.style.borderColor   = '#fca5a5';
                            capBadge.style.color         = '#b42318';
                        } else {
                            capBadge.style.background  = '#dcfce7';
                            capBadge.style.borderColor = '#bbf7d0';
                            capBadge.style.color       = '#15803d';
                        }
                    } else {
                        capBadge.textContent = 'No limit';
                    }
                    document.getElementById('classInfo').classList.remove('d-none');
                }

                if (data.classIsFull) {
                    document.getElementById('classFullAlert').classList.remove('d-none');

                    // Wire override button — pass the class package id
                    const overrideBtn = document.getElementById('btnOverrideClassFull');
                    overrideBtn.onclick = function () {
                        // Find the class package option (CLASS type)
                        const classOpt = (data.packageOptions || []).find(o => o.packageTypeCode === 'CLASS');
                        if (!classOpt) {
                            showModalError('No CLASS Package', 'No class package available to override with.');
                            return;
                        }
                        markAttendance(data.memberId, classOpt.memberPackageId, classOpt.label, true);
                    };
                }

                if (data.alreadyInsideGym) {
                    alreadyAlert.classList.remove('d-none');
                }

                if (data.autoCheckedInRecordId) {
                    autoAlert.classList.remove('d-none');
                    document.getElementById('autoPackageName').textContent =
                        data.autoCheckedInPackageName ?? '';
                    refreshStats();
                    // Advance poller cursor so it doesn't re-show this check-in
                    if (window.advancePollerCursor) {
                        window.advancePollerCursor(new Date().toISOString());
                    }
                }

                if ((data.hasConflict || data.requiresClassChoice) && !data.alreadyInsideGym && data.packageOptions) {
                    conflictSection.classList.remove('d-none');

                    document.getElementById('conflictNote').textContent = data.hasConflict
                        ? 'This member has multiple active packages. Please select how to check them in:'
                        : 'Select how to check this member in:';

                    data.packageOptions.forEach(function (opt) {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'package-btn';

                        btn.innerHTML =
                            `${opt.label}`
                            + (opt.sessionsRemaining ? ` <small style="color:#6b7280;">(${opt.sessionsRemaining})</small>` : '');

                        btn.addEventListener('click', function () {
                            // Session packages must be tied to a class — open the class picker.
                            if (opt.packageTypeCode === 'SESSION') {
                                openClassPicker(data, opt);
                            } else {
                                markAttendance(data.memberId, opt.memberPackageId, opt.label);
                            }
                        });

                        packageButtons.appendChild(btn);
                    });
                }

                showSessionsLeft(data);
                showPerkPanels(data);
                openModal();
                playSuccessFeedback();
            }

            function showModalError(title, message) {
                modalError.classList.remove('d-none');
                modalSuccess.classList.add('d-none');

                document.getElementById('modalErrorTitle').textContent = title ?? 'Entry Denied';
                document.getElementById('modalErrorMessage').textContent = message ?? 'Unknown error.';

                openModal();
            }

            // Show the class picker for a session-package check-in.
            function openClassPicker(data, opt) {
                const section      = document.getElementById('classPickerSection');
                const select       = document.getElementById('classPickerSelect');
                const fullWarn     = document.getElementById('classPickerFullWarn');
                const overrideChk  = document.getElementById('classPickerOverride');
                const classes      = data.classOptions || [];

                packageButtons.classList.add('d-none');
                section.classList.remove('d-none');

                select.innerHTML = '';
                if (!classes.length) {
                    const o = document.createElement('option');
                    o.value = '';
                    o.textContent = 'No classes scheduled today';
                    select.appendChild(o);
                } else {
                    classes.forEach(function (c) {
                        const o = document.createElement('option');
                        o.value = c.gymClassId;
                        const cap = (c.capacity != null) ? ` (${c.attendeeCount}/${c.capacity})` : '';
                        const coach = c.coachName ? ` · ${c.coachName}` : '';
                        o.textContent = `${c.className} · ${c.timeDisplay}${coach}${cap}${c.isFull ? ' — FULL' : ''}`;
                        o.dataset.full = c.isFull ? '1' : '0';
                        select.appendChild(o);
                    });
                }

                function syncFull() {
                    const sel = select.options[select.selectedIndex];
                    const isFull = sel && sel.dataset.full === '1';
                    if (isFull) {
                        fullWarn.classList.remove('d-none');
                    } else {
                        fullWarn.classList.add('d-none');
                        overrideChk.checked = false;
                    }
                }
                overrideChk.checked = false;
                select.onchange = syncFull;
                syncFull();

                document.getElementById('btnConfirmClass').onclick = function () {
                    if (!classes.length || !select.value) {
                        showModalError('No Class Selected', 'Select the class the member is attending.');
                        return;
                    }
                    const sel = select.options[select.selectedIndex];
                    const isFull = sel && sel.dataset.full === '1';
                    markAttendance(data.memberId, opt.memberPackageId, opt.label,
                                   isFull && overrideChk.checked, select.value);
                };
                document.getElementById('btnCancelClass').onclick = function () {
                    section.classList.add('d-none');
                    packageButtons.classList.remove('d-none');
                };
            }

            async function markAttendance(memberId, memberPackageId, label, overrideClassCapacity, selectedGymClassId) {
                packageButtons.querySelectorAll('button').forEach(function (b) {
                    b.disabled = true;
                });
                const overrideBtn = document.getElementById('btnOverrideClassFull');
                if (overrideBtn) overrideBtn.disabled = true;
                const confirmClassBtn = document.getElementById('btnConfirmClass');
                if (confirmClassBtn) confirmClassBtn.disabled = true;

                try {
                    const res = await fetch('/Reception/MarkAttendance', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiforgery
                        },
                        body: JSON.stringify({
                            memberId: memberId,
                            branchId: branchId,
                            selectedMemberPackageId: memberPackageId,
                            selectedGymClassId: selectedGymClassId || null,
                            overrideClassCapacity: overrideClassCapacity === true
                        })
                    });

                    const data = await res.json();

                    conflictSection.classList.add('d-none');
                    document.getElementById('classFullAlert').classList.add('d-none');
                    document.getElementById('classPickerSection').classList.add('d-none');

                    if (data.success) {
                        autoAlert.classList.remove('d-none');
                        document.getElementById('autoPackageName').textContent = label;
                        refreshStats();
                        // Advance poller cursor so it doesn't re-show this check-in
                        if (window.advancePollerCursor) {
                            window.advancePollerCursor(new Date().toISOString());
                        }
                    }
                    else {
                        showModalError('Check-In Failed', data.errorMessage ?? 'Unknown error.');
                    }
                }
                catch {
                    showModalError('Network Error', 'Could not reach server.');
                }
                finally {
                    if (overrideBtn) overrideBtn.disabled = false;
                    if (confirmClassBtn) confirmClassBtn.disabled = false;
                }
            }

            // Fill progress bars for live classes based on elapsed time
            (function initLiveBars() {
                @{ int barIdx = 0; }
                @foreach (var cls in (dashboard?.TodayClasses ?? new()))
                {
                    barIdx++;
                    if (cls.IsLive)
                    {
                        // Parse start/end from TimeDisplay "HH:mm – HH:mm"
                        var parts = cls.TimeDisplay.Split('–');
                        if (parts.Length == 2)
                        {
                            var startStr = parts[0].Trim();
                            var endStr   = parts[1].Trim();
                            <text>
                            (function() {
                                var bar = document.getElementById('liveBar_@barIdx');
                                if (!bar) return;
                                var now   = new Date();
                                var start = new Date(now.getFullYear(), now.getMonth(), now.getDate(),
                                                     parseInt('@startStr'.split(':')[0]), parseInt('@startStr'.split(':')[1]));
                                var end   = new Date(now.getFullYear(), now.getMonth(), now.getDate(),
                                                     parseInt('@endStr'.split(':')[0]),  parseInt('@endStr'.split(':')[1]));
                                var pct   = Math.min(100, Math.max(0, (now - start) / (end - start) * 100));
                                bar.style.width = pct.toFixed(1) + '%';
                            })();
                            </text>
                        }
                    }
                }
            })();

            async function refreshStats() {
                try {
                    const res = await fetch(`/Reception/Stats?branchId=${branchId}`);
                    const data = await res.json();

                    const currently = document.getElementById('statCurrently');
                    const today = document.getElementById('statToday');

                    if (currently) currently.textContent = data.currentlyPresentCount;
                    if (today) today.textContent = data.todayEntryCount;

                    // Update capacity ring
                    updateCapacityRing(data.currentlyPresentCount, data.maxCapacity ?? 0);
                }
                catch {
                }
            }

            function updateCapacityRing(current, maxCap) {
                const arc    = document.getElementById('capacityArc');
                const note   = document.getElementById('capNote');
                const count  = document.getElementById('capCount');
                if (!arc) return;

                const r    = 28;
                const circ = 2 * Math.PI * r;

                if (maxCap > 0) {
                    const pct  = Math.min(100, Math.round(current / maxCap * 100));
                    const dash = circ * pct / 100;
                    arc.setAttribute('stroke-dasharray', `${dash.toFixed(1)} ${circ.toFixed(1)}`);
                    arc.setAttribute('stroke',
                        pct >= 90 ? '#dc2626' : pct >= 70 ? '#f59e0b' : '#16a34a');
                    // Update the text inside SVG
                    const txt = arc.parentElement.querySelector('text');
                    if (txt) txt.textContent = pct + '%';
                    if (note) note.textContent = pct + '% full';
                    if (count) count.firstChild.textContent = current;
                } else {
                    if (count) count.firstChild.textContent = current;
                }
            }

            function resetModal() {
                modalError.classList.add('d-none');
                modalSuccess.classList.remove('d-none');
                alreadyAlert.classList.add('d-none');
                autoAlert.classList.add('d-none');
                conflictSection.classList.add('d-none');
                packageButtons.innerHTML = '';
                packageButtons.classList.remove('d-none');
                document.getElementById('classPickerSection').classList.add('d-none');
                document.getElementById('classPickerFullWarn').classList.add('d-none');
                document.getElementById('classPickerOverride').checked = false;
                document.getElementById('memberPhone').classList.add('d-none');
                document.getElementById('memberPhoneVal').textContent = '';
                document.getElementById('memberPackageInfo').classList.add('d-none');
                document.getElementById('classInfo').classList.add('d-none');
                document.getElementById('classFullAlert').classList.add('d-none');
                document.getElementById('sessionsLeftAlert').classList.add('d-none');
                document.getElementById('ptPerkPanel').classList.add('d-none');
                document.getElementById('inBodyPerkPanel').classList.add('d-none');
                document.getElementById('ptFeedback').textContent = '';
                modal.classList.remove('scan-success-anim');
                // Restore default conflict note (pending flow overrides it)
                const note = conflictSection.querySelector('.stat-note');
                if (note) note.textContent =
                    'This member has multiple active packages. Please select how to check them in:';
            }

            // ── PT / InBody perk panels ───────────────────────────────
            function showPerkPanels(data) {
                // PT sessions
                const ptPackages = data.ptPackageOptions || [];
                if (ptPackages.length) {
                    const packageSel = document.getElementById('ptPackageSelect');
                    const coachSel = document.getElementById('ptCoachSelect');

                    const renderPackageOptions = function () {
                        packageSel.innerHTML = '';
                        ptPackages.forEach(function (p) {
                            const opt = document.createElement('option');
                            opt.value = p.memberPackageId;
                            opt.textContent = p.packageName + ' · ' + p.sourceLabel + ' · ' + p.sessionsRemaining + ' left';
                            packageSel.appendChild(opt);
                        });
                    };

                    coachSel.innerHTML = '';
                    (data.coachOptions || []).forEach(function (c) {
                        const opt = document.createElement('option');
                        opt.value = c.coachId;
                        opt.textContent = c.name;
                        coachSel.appendChild(opt);
                    });
                    if (!coachSel.options.length) {
                        const opt = document.createElement('option');
                        opt.value = '';
                        opt.textContent = 'No coaches at this branch';
                        coachSel.appendChild(opt);
                    }

                    const syncSelectedPackage = function () {
                        const selected = ptPackages.find(p => p.memberPackageId === packageSel.value)
                            || ptPackages[0];
                        document.getElementById('ptRemainingNum').textContent =
                            selected?.sessionsRemaining ?? 0;
                        if (selected?.assignedCoachId) {
                            const coachExists = Array.from(coachSel.options)
                                .some(o => o.value === selected.assignedCoachId);
                            if (coachExists) coachSel.value = selected.assignedCoachId;
                        }
                    };

                    renderPackageOptions();
                    syncSelectedPackage();
                    packageSel.onchange = syncSelectedPackage;

                    const btn = document.getElementById('btnRecordPt');
                    btn.onclick = function () {
                        recordPt(data.memberId, packageSel.value, coachSel.value, ptPackages, renderPackageOptions, syncSelectedPackage);
                    };
                    document.getElementById('ptPerkPanel').classList.remove('d-none');
                }

                // InBody
                if (typeof data.inBodyRemaining === 'number' && data.inBodyRemaining > 0) {
                    document.getElementById('inBodyRemainingNum').textContent = data.inBodyRemaining;
                    const btn = document.getElementById('btnRecordInBody');
                    btn.onclick = function () {
                        recordInBody(data.memberId, data.inBodyPackageId);
                    };
                    document.getElementById('inBodyPerkPanel').classList.remove('d-none');
                }
            }

            async function recordPt(memberId, memberPackageId, coachId, ptPackages, renderPackageOptions, syncSelectedPackage) {
                const fb = document.getElementById('ptFeedback');
                if (!coachId) { fb.innerHTML = '<span style="color:#b42318;">Select a coach first.</span>'; return; }
                const btn = document.getElementById('btnRecordPt');
                btn.disabled = true;
                fb.innerHTML = '<span style="color:#6b7280;">Recording…</span>';
                try {
                    const res = await fetch('/Reception/RecordPtSession', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiforgery },
                        body: JSON.stringify({ memberId, memberPackageId, coachId, branchId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        document.getElementById('ptRemainingNum').textContent = data.remaining;
                        const selected = ptPackages.find(p => p.memberPackageId === memberPackageId);
                        if (selected) selected.sessionsRemaining = data.remaining;
                        const action = data.attendanceRecordId
                            ? 'Checked in and PT session recorded.'
                            : 'PT session recorded; member was already checked in.';
                        fb.innerHTML = '<span style="color:#16a34a;font-weight:700;"><i class="bi bi-check-circle-fill"></i> '
                            + action + ' ' + data.remaining + ' left.</span>';
                        refreshStats();
                        if (window.advancePollerCursor) {
                            window.advancePollerCursor(new Date().toISOString());
                        }
                        if (data.remaining <= 0) {
                            const index = ptPackages.findIndex(p => p.memberPackageId === memberPackageId);
                            if (index >= 0) ptPackages.splice(index, 1);
                            if (ptPackages.length) {
                                renderPackageOptions();
                                syncSelectedPackage();
                            } else {
                                setTimeout(() => document.getElementById('ptPerkPanel').classList.add('d-none'), 1200);
                            }
                        } else {
                            renderPackageOptions();
                            document.getElementById('ptPackageSelect').value = memberPackageId;
                        }
                    } else {
                        fb.innerHTML = `<span style="color:#b42318;">${data.errorMessage ?? 'Failed.'}</span>`;
                    }
                } catch {
                    fb.innerHTML = '<span style="color:#b42318;">Network error.</span>';
                } finally {
                    btn.disabled = false;
                }
            }

            async function recordInBody(memberId, memberPackageId) {
                const btn = document.getElementById('btnRecordInBody');
                btn.disabled = true;
                try {
                    const res = await fetch('/Reception/RecordInBody', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiforgery },
                        body: JSON.stringify({ memberId, memberPackageId, branchId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        document.getElementById('inBodyRemainingNum').textContent = data.remaining;
                        btn.innerHTML = '<i class="bi bi-check2-all"></i> Recorded';
                        if (data.remaining <= 0) {
                            setTimeout(() => document.getElementById('inBodyPerkPanel').classList.add('d-none'), 1200);
                        } else {
                            setTimeout(() => { btn.innerHTML = '<i class="bi bi-check2"></i> Record InBody'; btn.disabled = false; }, 1200);
                        }
                    } else {
                        alert(data.errorMessage ?? 'Failed to record InBody.');
                        btn.disabled = false;
                    }
                } catch {
                    btn.disabled = false;
                }
            }

            // ── Pick the best sessions-remaining value to display.
            //    Prefers the auto-checked-in package; otherwise the first session-based option.
            function showSessionsLeft(data) {
                const opts = data.packageOptions || [];
                let chosen = null;

                if (data.autoCheckedInPackageName) {
                    chosen = opts.find(o => o.sessionsRemaining
                                         && o.packageName === data.autoCheckedInPackageName);
                }
                if (!chosen) chosen = opts.find(o => o.sessionsRemaining);
                if (!chosen) return;

                const m = /(\d+)/.exec(chosen.sessionsRemaining);
                if (!m) return;

                let n = parseInt(m[1], 10);
                // If we just auto-deducted a session for THIS package, show post-deduction count.
                if (data.autoCheckedInPackageName === chosen.packageName) n = Math.max(0, n - 1);

                document.getElementById('sessionsLeftNum').textContent = n;
                document.getElementById('sessionsLeftLabel').textContent =
                    n === 1 ? 'session remaining' : 'sessions remaining';
                document.getElementById('sessionsLeftPkgName').textContent = chosen.packageName || '';
                document.getElementById('sessionsLeftAlert').classList.remove('d-none');
            }

            // ── Short upbeat chime via Web Audio API (no asset needed).
            let _audioCtx = null;
            function playScanSound() {
                try {
                    _audioCtx = _audioCtx || new (window.AudioContext || window.webkitAudioContext)();
                    const ctx = _audioCtx;
                    if (ctx.state === 'suspended') ctx.resume();
                    const now = ctx.currentTime;
                    // Two ascending tones: G5 → C6
                    [[784, 0], [1046.5, 0.11]].forEach(([freq, offset]) => {
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.value = freq;
                        gain.gain.setValueAtTime(0.0001, now + offset);
                        gain.gain.exponentialRampToValueAtTime(0.25, now + offset + 0.02);
                        gain.gain.exponentialRampToValueAtTime(0.0001, now + offset + 0.22);
                        osc.connect(gain).connect(ctx.destination);
                        osc.start(now + offset);
                        osc.stop(now + offset + 0.24);
                    });
                } catch { /* audio not available — skip silently */ }
            }

            function playSuccessFeedback() {
                playScanSound();
                modal.classList.remove('scan-success-anim');
                // force reflow so the animation restarts on repeated scans
                void modal.offsetWidth;
                modal.classList.add('scan-success-anim');
            }

            function openModal() {
                overlay.classList.add('is-open');
                modal.classList.add('is-open');
                // Disable Check In button so a stray Enter can't double-fire
                if (btnScan) btnScan.disabled = true;
            }

            function closeModal() {
                overlay.classList.remove('is-open');
                modal.classList.remove('is-open');
                // Clear the input and re-enable Check In
                if (input)   input.value = '';
                if (btnScan) btnScan.disabled = false;
                // Refocus input so the next member can be scanned immediately
                setTimeout(() => input?.focus(), 50);
            }

            function setLoading(on) {
                btnScan.disabled = on;
                spinner.classList.toggle('d-none', !on);
            }

            function getErrorTitle(code) {
                return ({
                    MEMBER_NOT_FOUND: 'Member Not Found',
                    MEMBER_INACTIVE: 'Inactive Account',
                    NO_ACTIVE_PACKAGE: 'No Active Package',
                    NO_AVAILABLE_VISITS: 'No Sessions Remaining',
                    BRANCH_ACCESS_DENIED: 'Access Denied',
                    BRANCH_NOT_FOUND: 'Branch Not Found'
                })[code] ?? 'Entry Denied';
            }

            // ── Auto-popup polling ─────────────────────────────────
            // Polls every 3 s for check-ins from ANY source (mobile app,
            // QR, web). Inside the main IIFE so it can see branchId,
            // refreshStats, resetModal, modal, openModal, etc.
            let pollerLastSeenUtc = new Date().toISOString();
            let pollerActive = true;

            // Lets the manual scan flow advance the cursor after a
            // successful web check-in to avoid re-showing the same record.
            window.advancePollerCursor = function (isoTimestamp) {
                if (isoTimestamp && isoTimestamp > pollerLastSeenUtc) {
                    pollerLastSeenUtc = isoTimestamp;
                }
            };

            function isModalOpen() {
                return modal.classList.contains('is-open');
            }

            async function poll() {
                if (!pollerActive || !branchId) return;
                try {
                    const url = `/Reception/LatestCheckIn?branchId=${branchId}&sinceUtc=${encodeURIComponent(pollerLastSeenUtc)}`;
                    const res  = await fetch(url);
                    const data = await res.json();
                    if (data.found) {
                        pollerLastSeenUtc = data.checkInAtUtc;
                        refreshStats();
                        if (!isModalOpen()) {
                            showAutoCheckInPopup(data);
                        }
                    }
                } catch { /* keep polling on network hiccup */ }
                if (pollerActive) setTimeout(poll, 3000);
            }

            document.addEventListener('visibilitychange', () => {
                pollerActive = !document.hidden;
                if (pollerActive) poll();
            });

            // Start polling — first poll after 3 s
            setTimeout(poll, 3000);

            function showAutoCheckInPopup(data) {
                resetModal();

                // Mobile QR scan that needs the receptionist to choose class vs open gym.
                if (data.requiresChoice) {
                    showPendingChoicePopup(data);
                    return;
                }

                document.getElementById('memberName').textContent      = data.memberName        ?? '—';
                document.getElementById('membershipBadge').textContent = data.membershipNumber  ?? '—';

                const photo = document.getElementById('memberPhoto');
                photo.src = data.photoUrl ? data.photoUrl : '/images/avatar-placeholder.png';

                if (data.phoneNumber) {
                    document.getElementById('memberPhoneVal').textContent = data.phoneNumber;
                    document.getElementById('memberPhone').classList.remove('d-none');
                }

                if (data.packageName) {
                    document.getElementById('memberPackageName').textContent  = data.packageName;
                    document.getElementById('memberPackageExpiry').textContent = '';
                    document.getElementById('memberPackageInfo').classList.remove('d-none');
                }

                autoAlert.classList.remove('d-none');
                document.getElementById('autoPackageName').textContent = data.packageName ?? 'Mobile check-in';

                if (typeof data.sessionsRemaining === 'number') {
                    document.getElementById('sessionsLeftNum').textContent = data.sessionsRemaining;
                    document.getElementById('sessionsLeftLabel').textContent =
                        data.sessionsRemaining === 1 ? 'session remaining' : 'sessions remaining';
                    document.getElementById('sessionsLeftPkgName').textContent = data.packageName ?? '';
                    document.getElementById('sessionsLeftAlert').classList.remove('d-none');
                }

                openModal();
                playSuccessFeedback();
            }

            // ── Pending mobile-scan: receptionist chooses the package ──
            function showPendingChoicePopup(data) {
                document.getElementById('memberName').textContent      = data.memberName        ?? '—';
                document.getElementById('membershipBadge').textContent = data.membershipNumber  ?? '—';

                const photo = document.getElementById('memberPhoto');
                photo.src = data.photoUrl ? data.photoUrl : '/images/avatar-placeholder.png';

                if (data.phoneNumber) {
                    document.getElementById('memberPhoneVal').textContent = data.phoneNumber;
                    document.getElementById('memberPhone').classList.remove('d-none');
                }

                conflictSection.classList.remove('d-none');
                conflictSection.querySelector('.stat-note').textContent =
                    'Mobile QR scan — choose which package this member is attending under:';
                packageButtons.innerHTML = '';

                (data.packageOptions || []).forEach(function (opt) {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'package-btn';
                    btn.innerHTML = `${opt.label}`
                        + (opt.sessionsRemaining ? ` <small style="color:#6b7280;">(${opt.sessionsRemaining})</small>` : '');
                    btn.addEventListener('click', function () {
                        confirmPending(data.attendanceRecordId, opt.memberPackageId, opt.label);
                    });
                    packageButtons.appendChild(btn);
                });

                openModal();
                playSuccessFeedback();
            }

            async function confirmPending(attendanceRecordId, memberPackageId, label) {
                packageButtons.querySelectorAll('button').forEach(b => b.disabled = true);
                try {
                    const res = await fetch('/Reception/ConfirmPending', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiforgery
                        },
                        body: JSON.stringify({
                            attendanceRecordId: attendanceRecordId,
                            selectedMemberPackageId: memberPackageId
                        })
                    });
                    const data = await res.json();

                    conflictSection.classList.add('d-none');

                    if (data.success) {
                        autoAlert.classList.remove('d-none');
                        document.getElementById('autoPackageName').textContent = data.packageName ?? label;

                        if (typeof data.sessionsRemaining === 'number') {
                            document.getElementById('sessionsLeftNum').textContent = data.sessionsRemaining;
                            document.getElementById('sessionsLeftLabel').textContent =
                                data.sessionsRemaining === 1 ? 'session remaining' : 'sessions remaining';
                            document.getElementById('sessionsLeftPkgName').textContent = data.packageName ?? '';
                            document.getElementById('sessionsLeftAlert').classList.remove('d-none');
                        }
                        refreshStats();
                        if (window.advancePollerCursor) {
                            window.advancePollerCursor(new Date().toISOString());
                        }
                    } else {
                        showModalError('Confirm Failed', data.errorMessage ?? 'Unknown error.');
                    }
                } catch {
                    showModalError('Network Error', 'Could not reach server.');
                    packageButtons.querySelectorAll('button').forEach(b => b.disabled = false);
                }
            }
        })();

        // ── Invitation Widget ──────────────────────────────────────
        (function () {
            let currentMemberId = null;

            const searchInput  = document.getElementById('invMemberSearch');
            const searchBtn    = document.getElementById('invSearchBtn');
            const resultEl     = document.getElementById('invMemberResult');
            const step2        = document.getElementById('invStep2');
            const memberPhoto  = document.getElementById('invMemberPhoto');
            const memberName   = document.getElementById('invMemberName');
            const memberSlots  = document.getElementById('invMemberSlots');
            const guestName    = document.getElementById('invGuestNameR');
            const guestPhone   = document.getElementById('invGuestPhoneR');
            const feedback     = document.getElementById('invFeedback');
            const submitBtn    = document.getElementById('invSubmitBtn');
            const resetBtn     = document.getElementById('invResetBtn');
            const antiforgery  = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

            if (!searchBtn) return;

            searchBtn.addEventListener('click', doMemberLookup);
            searchInput?.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') doMemberLookup();
            });

            resetBtn?.addEventListener('click', resetWidget);
            submitBtn?.addEventListener('click', doSubmitInvitation);

            async function doMemberLookup() {
                const q = searchInput.value.trim();
                if (!q) return;

                resultEl.innerHTML = '<span style="color:#9ca3af;">Searching...</span>';

                try {
                    const res  = await fetch(`/Invitations/MemberLookup?q=${encodeURIComponent(q)}`);
                    const data = await res.json();

                    if (!data.found) {
                        resultEl.innerHTML = '<span style="color:#b42318;">Member not found.</span>';
                        step2.style.display = 'none';
                        currentMemberId = null;
                        return;
                    }

                    if (!data.hasInvitations) {
                        resultEl.innerHTML = `<span style="color:#b54708;">⚠ <strong>${data.name}</strong> has no invitation slots remaining.</span>`;
                        step2.style.display = 'none';
                        currentMemberId = null;
                        return;
                    }

                    resultEl.innerHTML = '';
                    currentMemberId = data.memberId;

                    memberPhoto.src  = data.photoUrl ?? '/images/avatar-placeholder.png';
                    memberName.textContent  = data.name + ' — #' + data.membershipNumber;
                    memberSlots.textContent = data.invitationsRemaining + ' invitation slot' + (data.invitationsRemaining !== 1 ? 's' : '') + ' remaining';

                    step2.style.display = 'block';
                    feedback.innerHTML  = '';
                    guestName.value     = '';
                    guestPhone.value    = '';
                    guestName.focus();
                }
                catch {
                    resultEl.innerHTML = '<span style="color:#b42318;">Search failed. Try again.</span>';
                }
            }

            async function doSubmitInvitation() {
                if (!currentMemberId) return;

                const name  = guestName.value.trim();
                const phone = guestPhone.value.trim();

                if (!name) {
                    feedback.innerHTML = '<span style="color:#b42318;">Guest name is required.</span>';
                    guestName.focus();
                    return;
                }
                if (!phone) {
                    feedback.innerHTML = '<span style="color:#b42318;">Guest phone is required.</span>';
                    guestPhone.focus();
                    return;
                }

                submitBtn.disabled = true;
                feedback.innerHTML = '<span style="color:#9ca3af;">Recording...</span>';

                try {
                    const res  = await fetch('/Invitations/CreateAtReception', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiforgery
                        },
                        body: JSON.stringify({
                            memberId: currentMemberId,
                            guestName: name,
                            guestPhone: phone,
                        })
                    });

                    const data = await res.json();

                    if (data.success) {
                        feedback.innerHTML = `<span style="color:#027a48;font-weight:700;">✓ Invitation recorded for ${data.guestName}!</span>`;
                        memberSlots.textContent = data.invitationsRemaining + ' invitation slot' + (data.invitationsRemaining !== 1 ? 's' : '') + ' remaining';
                        guestName.value  = '';
                        guestPhone.value = '';

                        if (data.invitationsRemaining === 0) {
                            setTimeout(resetWidget, 2000);
                        }
                    } else {
                        feedback.innerHTML = `<span style="color:#b42318;">${data.message ?? 'Failed to record invitation.'}</span>`;
                    }
                }
                catch {
                    feedback.innerHTML = '<span style="color:#b42318;">Network error. Try again.</span>';
                }
                finally {
                    submitBtn.disabled = false;
                }
            }

            function resetWidget() {
                searchInput.value      = '';
                resultEl.innerHTML     = '';
                step2.style.display    = 'none';
                currentMemberId        = null;
                guestName.value        = '';
                guestPhone.value       = '';
                feedback.innerHTML     = '';
                searchInput.focus();
            }
        })();
    </script>
}

@model GymSaaS.Models.CoachDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    var pct = Model.TargetProgress;
    var pctColor = pct >= 100 ? "#16a34a" : (pct >= 50 ? "#f59e0b" : "#dc2626");
    var initials = string.Concat(Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]));
}

@section Styles {
    <style>
        .coach-hero {
            background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
            border-radius: 16px;
            padding: 28px 32px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 22px;
            margin-bottom: 22px;
            box-shadow: 0 10px 28px rgba(249,115,22,.25);
        }
        .coach-hero-avatar {
            width: 80px; height: 80px; border-radius: 50%;
            background: rgba(255,255,255,.18); border: 3px solid rgba(255,255,255,.4);
            display: flex; align-items: center; justify-content: center;
            font-size: 28px; font-weight: 800; flex-shrink: 0; overflow: hidden;
        }
        .coach-hero-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .coach-hero-name { font-size: 22px; font-weight: 800; }
        .coach-hero-specialty { font-size: 13px; opacity: .9; margin-top: 4px; font-weight: 500; }
        .coach-hero-meta { margin-left: auto; text-align: right; font-size: 12px; opacity: .85; }
        .coach-hero-meta strong { display:block; font-size: 16px; font-weight: 700; margin-top: 2px; }

        .stats-row {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 14px; margin-bottom: 22px;
        }
        @@media (max-width: 900px) { .stats-row { grid-template-columns: repeat(2, 1fr); } }

        .stat-tile {
            background: #fff; border: 1px solid #e8e8e8;
            border-radius: 12px; padding: 18px;
            position: relative; overflow: hidden;
        }
        .stat-tile-icon {
            position: absolute; top: 14px; right: 14px;
            width: 36px; height: 36px; border-radius: 9px;
            display: flex; align-items: center; justify-content: center; font-size: 17px;
        }
        .stat-tile-label {
            font-size: 11px; font-weight: 700; letter-spacing: .08em;
            text-transform: uppercase; color: #9ca3af; margin-bottom: 6px;
        }
        .stat-tile-value { font-size: 28px; font-weight: 800; color: #111; line-height: 1; }
        .stat-tile-sub { font-size: 12px; color: #6b7280; margin-top: 8px; }
        .progress-bar { height: 6px; background: #f3f4f6; border-radius: 3px; margin-top: 10px; overflow: hidden; }
        .progress-bar > div { height: 100%; border-radius: 3px; transition: width .3s; }

        .content-row {
            display: grid; grid-template-columns: 1fr 1fr;
            gap: 18px; margin-bottom: 22px;
        }
        @@media (max-width: 900px) { .content-row { grid-template-columns: 1fr; } }

        .panel {
            background: #fff; border: 1px solid #e8e8e8;
            border-radius: 12px; overflow: hidden;
        }
        .panel-head {
            padding: 14px 18px; border-bottom: 1px solid #f1f1f1;
            display: flex; align-items: center; justify-content: space-between;
        }
        .panel-title {
            font-size: 12.5px; font-weight: 700;
            letter-spacing: .06em; text-transform: uppercase; color: #111;
            display: flex; align-items: center; gap: 8px;
        }
        .panel-title i { color: #f97316; }
        .panel-link { font-size: 12px; color: #f97316; text-decoration: none; font-weight: 600; }
        .panel-body { padding: 16px 18px; }
        .panel-empty { padding: 28px 16px; text-align: center; color: #9ca3af; font-size: 13px; }

        .list-row {
            display: flex; align-items: center; gap: 12px;
            padding: 11px 0; border-bottom: 1px solid #f5f5f5;
        }
        .list-row:last-child { border-bottom: none; }
        .list-row-icon {
            width: 34px; height: 34px; border-radius: 8px;
            background: rgba(249,115,22,.1); color: #ea580c;
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; flex-shrink: 0;
        }
        .list-row-main { flex: 1; min-width: 0; }
        .list-row-name { font-size: 13.5px; font-weight: 600; color: #111; }
        .list-row-sub { font-size: 11.5px; color: #6b7280; margin-top: 2px; }
        .list-row-right { font-size: 12px; font-weight: 700; flex-shrink: 0; text-align: right; }

        .actions-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
        @@media (max-width: 700px) { .actions-row { grid-template-columns: 1fr; } }
        .action-tile {
            background: #fff; border: 1px solid #e8e8e8; border-radius: 12px;
            padding: 18px 20px; text-decoration: none; color: inherit;
            display: flex; align-items: center; gap: 14px;
            transition: transform .15s, box-shadow .15s, border-color .15s;
        }
        .action-tile:hover {
            transform: translateY(-2px); box-shadow: 0 8px 22px rgba(0,0,0,.06);
            border-color: #f97316; color: inherit; text-decoration: none;
        }
        .action-tile-icon {
            width: 44px; height: 44px; border-radius: 11px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; flex-shrink: 0;
        }
        .action-tile-title { font-size: 14.5px; font-weight: 700; color: #111; }
        .action-tile-sub { font-size: 12px; color: #6b7280; margin-top: 2px; }
    </style>
}

<div class="coach-hero">
    <div class="coach-hero-avatar">
        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
        {
            <img src="@Model.PhotoUrl" alt="@Model.FullName" />
        }
        else
        {
            @initials
        }
    </div>
    <div>
        <div class="coach-hero-name">Welcome back, @Model.FullName</div>
        <div class="coach-hero-specialty"><i class="bi bi-award"></i> @Model.Specialty</div>
    </div>
    <div class="coach-hero-meta">
        @DateTime.Today.ToString("dddd")
        <strong>@DateTime.Today.ToString("dd MMM yyyy")</strong>
    </div>
</div>

<!-- Earnings spotlight row -->
<div class="stats-row" style="grid-template-columns:repeat(2,1fr);">
    <div class="stat-tile" style="background:linear-gradient(135deg, #16a34a 0%, #15803d 100%); color:#fff; border:none;">
        <div class="stat-tile-icon" style="background:rgba(255,255,255,.2);color:#fff"><i class="bi bi-cash-stack"></i></div>
        <div class="stat-tile-label" style="color:rgba(255,255,255,.85)">Earnings — @DateTime.Today.ToString("MMMM")</div>
        <div class="stat-tile-value" style="color:#fff">@Model.EarningsThisMonth.ToString("N0") <span style="font-size:14px;opacity:.85;font-weight:600">EGP</span></div>
        <div class="stat-tile-sub" style="color:rgba(255,255,255,.85)">From @Model.CommissionPackagesThisMonth private package@(Model.CommissionPackagesThisMonth == 1 ? "" : "s") this month</div>
    </div>
    <div class="stat-tile">
        <div class="stat-tile-icon" style="background:rgba(22,163,74,.12);color:#16a34a"><i class="bi bi-piggy-bank"></i></div>
        <div class="stat-tile-label">All-Time Earnings</div>
        <div class="stat-tile-value">@Model.EarningsAllTime.ToString("N0") <span style="font-size:14px;color:#9ca3af;font-weight:600">EGP</span></div>
        <div class="stat-tile-sub">Total commission earned to date</div>
    </div>
</div>

<div class="stats-row">
    <div class="stat-tile">
        <div class="stat-tile-icon" style="background:rgba(249,115,22,.12);color:#ea580c"><i class="bi bi-people"></i></div>
        <div class="stat-tile-label">Active Trainees</div>
        <div class="stat-tile-value">@Model.ActiveTraineeCount</div>
        @if (Model.CoachTarget > 0)
        {
            <div class="stat-tile-sub"><strong style="color:@pctColor">@pct%</strong> of target (@Model.CoachTarget)</div>
            <div class="progress-bar"><div style="width:@(Math.Min(pct,100))%;background:@pctColor"></div></div>
        }
        else
        {
            <div class="stat-tile-sub" style="font-style:italic">No target set</div>
        }
    </div>
    <div class="stat-tile">
        <div class="stat-tile-icon" style="background:rgba(22,163,74,.12);color:#16a34a"><i class="bi bi-person-plus"></i></div>
        <div class="stat-tile-label">New This Month</div>
        <div class="stat-tile-value">@Model.NewTraineesThisMonth</div>
        <div class="stat-tile-sub">Trainees signed up in @DateTime.Today.ToString("MMMM")</div>
    </div>
    <div class="stat-tile">
        <div class="stat-tile-icon" style="background:rgba(59,130,246,.12);color:#3b82f6"><i class="bi bi-ticket-perforated"></i></div>
        <div class="stat-tile-label">Sessions in the Pipeline</div>
        <div class="stat-tile-value">@Model.SessionsRemainingTotal</div>
        <div class="stat-tile-sub">Across all active trainees</div>
    </div>
    <div class="stat-tile">
        <div class="stat-tile-icon" style="background:rgba(139,92,246,.12);color:#8b5cf6"><i class="bi bi-check2-circle"></i></div>
        <div class="stat-tile-label">Delivered This Month</div>
        <div class="stat-tile-value">@Model.SessionsDeliveredThisMonth</div>
        <div class="stat-tile-sub">Recorded attendances this month</div>
    </div>
</div>

<div class="stats-row" style="grid-template-columns:repeat(3,1fr);">
    <div class="stat-tile">
        <div class="stat-tile-icon" style="background:rgba(249,115,22,.12);color:#ea580c"><i class="bi bi-calendar-day"></i></div>
        <div class="stat-tile-label">Classes Today</div>
        <div class="stat-tile-value">@Model.TodayClassesCount</div>
        <div class="stat-tile-sub">@(Model.TodayClassesCount == 0 ? "No classes today" : "Scheduled for today")</div>
    </div>
    <div class="stat-tile">
        <div class="stat-tile-icon" style="background:rgba(220,38,38,.12);color:#dc2626"><i class="bi bi-exclamation-triangle"></i></div>
        <div class="stat-tile-label">Expiring Soon</div>
        <div class="stat-tile-value">@Model.ExpiringSoonCount</div>
        <div class="stat-tile-sub">Packages expiring within 30 days</div>
    </div>
    <div class="stat-tile">
        <div class="stat-tile-icon" style="background:rgba(59,130,246,.12);color:#3b82f6"><i class="bi bi-calendar-week"></i></div>
        <div class="stat-tile-label">Weekly Classes</div>
        <div class="stat-tile-value">@Model.ClassCount</div>
        <div class="stat-tile-sub">Total recurring classes</div>
    </div>
</div>

<div class="content-row">
    <div class="panel">
        <div class="panel-head">
            <div class="panel-title"><i class="bi bi-clock-history"></i> Today's Classes</div>
            <a asp-controller="Coaches" asp-action="MySchedule" class="panel-link">Full schedule →</a>
        </div>
        <div class="panel-body">
            @if (!Model.TodayClasses.Any())
            {
                <div class="panel-empty">
                    <i class="bi bi-cup-hot" style="font-size:28px;color:#d1d5db;display:block;margin-bottom:6px"></i>
                    No classes scheduled for today. Enjoy!
                </div>
            }
            else
            {
                foreach (var cls in Model.TodayClasses)
                {
                    <div class="list-row">
                        <div class="list-row-icon"><i class="bi bi-calendar2-week"></i></div>
                        <div class="list-row-main">
                            <div class="list-row-name">@cls.ClassName</div>
                            <div class="list-row-sub">@cls.StartTime.ToString("HH:mm") – @cls.EndTime.ToString("HH:mm")@(cls.Capacity.HasValue ? $" · capacity {cls.Capacity}" : "")</div>
                        </div>
                        <div class="list-row-right">
                            @{
                                var nowT = TimeOnly.FromDateTime(DateTime.Now);
                                string label = nowT < cls.StartTime ? "Upcoming" : (nowT < cls.EndTime ? "Live now" : "Ended");
                                var color = label == "Live now" ? "#16a34a" : (label == "Upcoming" ? "#f97316" : "#9ca3af");
                            }
                            <span style="color:@color">@label</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div class="panel-title"><i class="bi bi-hourglass-split"></i> Expiring Soon</div>
            <a asp-controller="Coaches" asp-action="MyTrainees" class="panel-link">All trainees →</a>
        </div>
        <div class="panel-body">
            @if (!Model.UpcomingExpirations.Any())
            {
                <div class="panel-empty">
                    <i class="bi bi-check-circle" style="font-size:28px;color:#d1d5db;display:block;margin-bottom:6px"></i>
                    No trainee packages expiring in the next 30 days.
                </div>
            }
            else
            {
                foreach (var t in Model.UpcomingExpirations)
                {
                    var dleft = t.DaysLeft;
                    var lblColor = dleft < 7 ? "#dc2626" : (dleft < 14 ? "#f59e0b" : "#6b7280");
                    <div class="list-row">
                        <div class="list-row-icon"><i class="bi bi-person"></i></div>
                        <div class="list-row-main">
                            <div class="list-row-name">@t.MemberName</div>
                            <div class="list-row-sub">@t.PackageName</div>
                        </div>
                        <div class="list-row-right">
                            <div style="color:@lblColor">@(dleft <= 0 ? "Today" : $"{dleft}d left")</div>
                            <div style="color:#9ca3af;font-weight:500;font-size:11px;margin-top:1px">@t.ValidToDate.ToString("dd MMM")</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Recent Earnings -->
<div class="panel" style="margin-bottom:22px;">
    <div class="panel-head">
        <div class="panel-title"><i class="bi bi-receipt"></i> Recent Commission Earnings</div>
        <div style="font-size:12px;color:#9ca3af">Latest private package sales</div>
    </div>
    <div class="panel-body">
        @if (!Model.RecentEarnings.Any())
        {
            <div class="panel-empty">
                <i class="bi bi-cash" style="font-size:28px;color:#d1d5db;display:block;margin-bottom:6px"></i>
                No commission earnings yet. When members are assigned to your private training packages, your earnings will appear here.
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table style="width:100%; border-collapse:collapse; font-size:13px;">
                    <thead>
                        <tr style="border-bottom:1px solid #e5e5e5; color:#6b7280; font-size:11px; text-transform:uppercase; letter-spacing:.06em;">
                            <th style="text-align:left; padding:8px 6px;">Member</th>
                            <th style="text-align:left; padding:8px 6px;">Package</th>
                            <th style="text-align:right; padding:8px 6px;">Price</th>
                            <th style="text-align:right; padding:8px 6px;">Your %</th>
                            <th style="text-align:right; padding:8px 6px;">You Earned</th>
                            <th style="text-align:right; padding:8px 6px;">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.RecentEarnings)
                        {
                            <tr style="border-bottom:1px solid #f3f4f6;">
                                <td style="padding:10px 6px; font-weight:600; color:#111;">@e.MemberName</td>
                                <td style="padding:10px 6px; color:#6b7280;">@e.PackageName</td>
                                <td style="padding:10px 6px; text-align:right; color:#6b7280;">@e.PackagePrice.ToString("N0")</td>
                                <td style="padding:10px 6px; text-align:right; color:#6b7280;">@e.CommissionPercent.ToString("0.##")%</td>
                                <td style="padding:10px 6px; text-align:right; font-weight:700; color:#16a34a;">+@e.CommissionAmount.ToString("N0") EGP</td>
                                <td style="padding:10px 6px; text-align:right; color:#9ca3af; font-size:11.5px;">@e.AssignedAtUtc.ToString("dd MMM")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="actions-row">
    <a asp-controller="Coaches" asp-action="MyTrainees" class="action-tile">
        <div class="action-tile-icon" style="background:rgba(249,115,22,.12);color:#ea580c"><i class="bi bi-person-arms-up"></i></div>
        <div style="flex:1">
            <div class="action-tile-title">My Trainees</div>
            <div class="action-tile-sub">View and manage your private training clients</div>
        </div>
        <i class="bi bi-chevron-right" style="color:#9ca3af"></i>
    </a>
    <a asp-controller="Coaches" asp-action="MySchedule" class="action-tile">
        <div class="action-tile-icon" style="background:rgba(59,130,246,.12);color:#3b82f6"><i class="bi bi-calendar2-week"></i></div>
        <div style="flex:1">
            <div class="action-tile-title">Weekly Schedule</div>
            <div class="action-tile-sub">Browse your full week of classes</div>
        </div>
        <i class="bi bi-chevron-right" style="color:#9ca3af"></i>
    </a>
</div>

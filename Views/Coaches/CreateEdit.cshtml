@model GymSaaS.Models.CoachFormViewModel

<style>
    .coach-validation-summary {
        background: rgba(220,38,38,.06);
        border: 1px solid rgba(220,38,38,.20);
        border-radius: 8px;
        color: #dc2626;
        font-size: 13px;
        padding: 12px 14px;
        margin-bottom: 16px;
    }
    /* MVC adds this class when there are no model errors — keep the box hidden then. */
    .coach-validation-summary.validation-summary-valid { display: none; }
    .coach-validation-summary ul { margin: 0; padding-left: 18px; }
</style>

<div class="page-header">
    <div>
        <div class="page-title">Coaches</div>
        <div class="page-subtitle">@ViewData["Subtitle"]</div>
    </div>
    <a asp-controller="Coaches" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div style="max-width:720px">
    <form asp-controller="Coaches" asp-action="@(Model.IsEdit ? "Edit" : "Create")"
          asp-route-id="@Model.CoachId" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="coach-validation-summary"></div>

        <!-- Basic info -->
        <div class="card" style="margin-bottom:20px">
            <div class="card-header">
                <span class="card-title">Basic Information</span>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                <div class="form-group">
                    <label asp-for="FirstName">First Name</label>
                    <input asp-for="FirstName" type="text" placeholder="e.g. Ahmed" />
                    <span asp-validation-for="FirstName" style="color:#dc2626;font-size:11px"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LastName">Last Name</label>
                    <input asp-for="LastName" type="text" placeholder="e.g. Hassan" />
                    <span asp-validation-for="LastName" style="color:#dc2626;font-size:11px"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Specialty">Specialty / What They Coach</label>
                <input asp-for="Specialty" type="text" placeholder="e.g. CrossFit, Yoga, Boxing, Personal Training" />
                <span asp-validation-for="Specialty" style="color:#dc2626;font-size:11px"></span>
            </div>

            <div class="form-group">
                <label>Assigned Branches</label>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:9px;padding:12px;border:1px solid var(--border);border-radius:8px;background:var(--bg-raised)">
                    @foreach (var b in Model.Branches)
                    {
                        <label style="display:flex;align-items:center;gap:9px;margin:0;padding:8px 10px;border:1px solid var(--border);border-radius:7px;cursor:pointer;background:var(--bg-card)">
                            <input type="checkbox" name="BranchIds" value="@b.BranchId"
                                   checked="@(Model.BranchIds.Contains(b.BranchId) ? "checked" : null)"
                                   style="width:16px;height:16px;accent-color:var(--orange)" />
                            <span style="font-size:13px;font-weight:600">@b.BranchName</span>
                        </label>
                    }
                </div>
                <span asp-validation-for="BranchIds" style="color:#dc2626;font-size:11px"></span>
                <div style="font-size:11.5px;color:var(--text-faint);margin-top:5px">
                    The coach can work, run classes, and record PT sessions at every selected branch.
                </div>
            </div>

            <div class="form-group" style="margin-bottom:0">
                <label asp-for="Bio">Bio</label>
                <textarea asp-for="Bio" rows="3" placeholder="Short profile description about this coach…" style="resize:vertical"></textarea>
            </div>
        </div>

        <!-- Contact -->
        <div class="card" style="margin-bottom:20px">
            <div class="card-header">
                <span class="card-title">Contact</span>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                <div class="form-group" style="margin-bottom:0">
                    <label asp-for="Phone">Phone</label>
                    <input asp-for="Phone" type="text" placeholder="+20 1xx xxx xxxx" />
                    <span asp-validation-for="Phone" style="color:#dc2626;font-size:11px"></span>
                </div>
                <div class="form-group" style="margin-bottom:0">
                    <label asp-for="Email">Email <span style="color:var(--orange)">*</span></label>
                    <input asp-for="Email" type="email" placeholder="coach@example.com" readonly="@(Model.IsEdit ? "readonly" : null)" />
                    <span asp-validation-for="Email" style="color:#dc2626;font-size:11px"></span>
                    @if (!Model.IsEdit)
                    {
                        <div style="font-size:11.5px;color:var(--text-faint);margin-top:5px">
                            <i class="bi bi-info-circle"></i> Used as the coach's login username.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Login account -->
        @if (!Model.IsEdit || Model.HasLinkedUser)
        {
            <div class="card" style="margin-bottom:20px;border:1px solid var(--orange);background:rgba(249,115,22,.04)">
                <div class="card-header">
                    <span class="card-title"><i class="bi bi-shield-lock" style="color:var(--orange)"></i> Login Account</span>
                </div>
                <div style="font-size:12.5px;color:var(--text-secondary);margin-bottom:14px">
                    @if (Model.IsEdit)
                    {
                        <span>Account: <strong>@Model.LinkedUserEmail</strong>. Leave both password fields blank to keep the current password.</span>
                    }
                    else
                    {
                        <span>A user account with the <strong>Coach</strong> role will be created. The coach will use the email above and this password to log in.</span>
                    }
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px">
                    <div class="form-group" style="margin-bottom:0">
                        <label asp-for="LoginPassword">@(Model.IsEdit ? "New Password" : "Initial Password") @if (!Model.IsEdit) { <span style="color:var(--orange)">*</span> }</label>
                        <input asp-for="LoginPassword" type="password" placeholder="Minimum 6 characters" autocomplete="new-password" />
                        <span asp-validation-for="LoginPassword" style="color:#dc2626;font-size:11px"></span>
                    </div>
                    <div class="form-group" style="margin-bottom:0">
                        <label asp-for="ConfirmLoginPassword">Confirm Password</label>
                        <input asp-for="ConfirmLoginPassword" type="password" placeholder="Enter the same password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmLoginPassword" style="color:#dc2626;font-size:11px"></span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card" style="margin-bottom:20px;border:1px solid var(--border);background:var(--bg-raised)">
                <div style="display:flex;align-items:center;gap:10px">
                    <i class="bi bi-exclamation-circle" style="color:#d97706;font-size:18px"></i>
                    <div>
                        <div style="font-size:13px;font-weight:600;color:var(--black)">No login account is linked</div>
                        <div style="font-size:12px;color:var(--text-secondary);margin-top:2px">A password cannot be changed for this legacy coach profile.</div>
                    </div>
                </div>
            </div>
        }

        <!-- Photo -->
        <div class="card" style="margin-bottom:20px">
            <div class="card-header">
                <span class="card-title">Profile Photo</span>
            </div>

            <div style="display:flex;align-items:center;gap:20px">
                <div id="photoPreviewWrap" style="flex-shrink:0">
                    @if (!string.IsNullOrEmpty(Model.ExistingPhotoUrl))
                    {
                        <img id="photoPreview" src="@Model.ExistingPhotoUrl"
                             style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:2px solid var(--border)"/>
                    }
                    else
                    {
                        <div id="photoPreview" style="width:80px;height:80px;border-radius:50%;background:var(--bg-raised);display:flex;align-items:center;justify-content:center;border:2px dashed var(--border)">
                            <i class="bi bi-person" style="font-size:28px;color:var(--text-faint)"></i>
                        </div>
                    }
                </div>
                <div>
                    <label style="text-transform:none;font-size:13px;font-weight:500;margin-bottom:6px;display:block" for="Photo">
                        Upload photo (JPG, PNG, WebP)
                    </label>
                    <input type="file" name="Photo" id="Photo" accept=".jpg,.jpeg,.png,.webp"
                           onchange="previewPhoto(this)"
                           style="font-size:13px;border:none;padding:0"/>
                </div>
            </div>
        </div>

        <!-- Performance Target -->
        <div class="card" style="margin-bottom:20px">
            <div class="card-header">
                <span class="card-title">Performance Target</span>
            </div>
            <div class="form-group" style="margin-bottom:0;max-width:300px">
                <label asp-for="CoachTarget">
                    <i class="bi bi-bullseye" style="color:var(--orange);margin-right:5px"></i>
                    Target Number of Trainees
                </label>
                <input asp-for="CoachTarget" type="number" min="0" max="999" placeholder="e.g. 15" />
                <div style="font-size:11.5px;color:var(--text-faint);margin-top:5px">
                    Goal number of active private-training members assigned to this coach. Used on the coach dashboard.
                </div>
                <span asp-validation-for="CoachTarget" style="color:#dc2626;font-size:11px"></span>
            </div>
        </div>

        <!-- Status -->
        <div class="card" style="margin-bottom:24px">
            <label style="display:flex;align-items:center;gap:10px;cursor:pointer;margin:0">
                <input asp-for="IsActive" type="checkbox" style="width:16px;height:16px;accent-color:var(--orange)" />
                <span style="font-size:13.5px;font-weight:500">Active — coach is currently working</span>
            </label>
        </div>

        <!-- Submit -->
        <div style="display:flex;gap:10px">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i>
                @(Model.IsEdit ? "Save Changes" : "Create Coach")
            </button>
            <a asp-controller="Coaches" asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    const wrap = document.getElementById('photoPreviewWrap');
                    wrap.innerHTML = `<img src="${e.target.result}" style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:2px solid var(--border)"/>`;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
